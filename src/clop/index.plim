                    p.text-stone-600.font-normal.font-mono.text-sm.mt-0 by `em Quinn Nelson`
                    iframe.shadow-xl.rounded-2xl.mt-4 width="560" height="315" loading="lazy" src="https://www.youtube-nocookie.com/embed/Aea2DUX4fsQ?si=wiqfyghn5jIyCxAU&amp;start=784" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen=""

            h1#pdf.text-3xl.text-center.lg:text-4xl.mb-8.text-black
                It even works on PDFs

            section#pdf-optimisation.feature
                .beside.flip
                    .copy
                        h1.feature-title Attach PDFs as large as books, literally
                        .text-base.lg:text-lg.text-gray-600
                            Heavy `b.text-ink-rose PDFs` like `em scans` and `em illustrations` usually don't fit in emails, and they take a long time to upload and download.
                        .text-base.lg:text-lg.text-gray-600
                            Clop can make those PDF files small enough to fit below the `b.text-ink-sky 25MB` limit of email attachments.
                    .demo
                        .demo-media
                            -if has_clip("pdfs")
                                -call feature="pdfs" alt="A heavy PDF optimised to fit an email" self:clip
                            -else
                                -call video="clop-pdf" cls="page-clip" controls=false defs:lazyvideoset
            section#pdf-cropping.feature
                .beside
                    .copy.dark-section
                        h1.feature-title Crop PDFs to fill the iPad screen
                        .text-base.lg:text-lg.text-gray-600
                            Some PDF files have large margins on an iPad, which can make them distracting while trying to focus on reading.
                        .text-base.lg:text-lg.text-gray-600
                            Clop's `b crop-pdf` CLI command can crop PDFs to fill the screen of any specific device.
                        -md
                            ```swift
                            clop crop-pdf --for-device "iPad Air" Calculus.pdf
                            ```
                    .demo
                        .demo-media
                            -if has_clip("pdf-crop-ipad")
                                -call feature="pdf-crop-ipad" alt="A PDF cropped to fill an iPad screen" self:clip
                            -else
                                -call img="clop-crop-pdf" factor=${0.3} mobile_factor=${0.9} pcls="block w-full" icls="w-full" alt="two iPads side by side showing a page of the same book, the left one has black borders at the top and bottom, the right iPad's screen is completely filled by the page" defs:image


            #pro.flex.flex-col.flex-center.max-w-[96vw]
                -stylus
                    @import "stylus/base"

                    #pro table
                        overflow hidden
                        a
                            text-decoration none

                    tbody tr td:first-of-type, thead tr th:first-of-type
                        text-align left
                        padding-left 3rem
                        +tablet()
                            padding-left 2rem
                        +mobile()
                            padding-left 1rem

                    tbody tr td(:not(:first-of-type))
                        padding-left 3rem
                        padding-right 3rem
                        +tablet()
                            padding-left 2rem
                            padding-right 2rem
                        +mobile()
                            padding-left 0.1rem
                            padding-right 0.1rem

                    tbody tr:nth-child(odd)
                        background-color unquote('color-mix(in srgb, var(--color-mauve-blackish) 5%, transparent)')

                h1.text-stone-800.my-0.md:mt-8.p-0.4xl:text-5xl `span.text-ink-sky Free` `span.text-stone-600.text-xl.font-medium vs` `span.font-bold.text-ink-rose Pro`
                h6.text-sm.text-stone-600.-mt-1 Free version features are free `b forever`
                h6.text-sm.text-stone-600.-mt-1 After the `b 14-day trial`, the app will continue to work with the free features
                div.flex.flex-col.flex-center.w-[96vw].mt-8
                    table.w-[95vw].xl:w-auto.bg-white.shadow-2xl.rounded-xl.text-black.border-collapse.text-xs.md:text-base.overflow-clip cellpadding="12px"
                        thead
                            tr
                                th.text-xs.md:text-lg.py-5.px-1.font-sans.font-medium Feature
                                th.text-sm.md:text-xl.py-5.px-1.font-bold.font-mono Clop Pro
                                th.text-xs.md:text-lg.py-5.px-1.font-sans.font-medium Free version
                        tbody
                            tr
                                td
                                    a.font-normal.text-black href="#clipboard" Automatic `b Clipboard` optimisation
                                    p.my-0.text-xxs.md:text-xs.font-medium.text-gray-400 Automatically optimise any image that gets copied to clipboard
                                td: icon.w-6.h-6.text-green-muted.mx-auto : checkmark
                                td: icon.w-6.h-6.text-green-muted.mx-auto : checkmark
                            tr
                                td
                                    a.font-normal.text-black href="#downscale" `b Downscale` and crop images
                                    p.my-0.text-xxs.md:text-xs.font-medium.text-gray-400 Use hotkeys to scale images down to smaller resolutions
                                td: icon.w-6.h-6.text-green-muted.mx-auto : checkmark
                                td: icon.w-6.h-6.text-green-muted.mx-auto : checkmark
                            tr
                                td
                                    a.font-normal.text-black href="#pipelines" `b Pipelines`
                                    p.my-0.text-xxs.md:text-xs.font-medium.text-gray-400 Chain steps and pin them to the clipboard, drop zone or folders
                                td: icon.w-6.h-6.text-green-muted.mx-auto : checkmark
                                td: icon.w-6.h-6.text-green-muted.mx-auto : checkmark
                            tr
                                td
                                    a.font-normal.text-black href="#format-bar" `b Format bar` and `b Fit under size`
