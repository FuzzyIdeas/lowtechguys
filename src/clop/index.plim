        -coffee
            url = new URL(location)
            coupon = url.searchParams.get('coupon')

            if coupon
                document.getElementById('btn-paddle-hero')?.setAttribute('data-coupon', coupon)
                document.getElementById('btn-paddle-footer')?.setAttribute('data-coupon', coupon)

            setupPaddle = () ->
                return unless Paddle?
                clearInterval paddleObserver
                Paddle.Setup({vendor: 122873})

            paddleObserver = setInterval setupPaddle, 100

            window.playVideo = (container) ->
                video = container.querySelector('video')
                playBtn = container.querySelector('.play-btn')
                poster = container.querySelector('.video-poster')
                return unless video.classList.contains('hidden')
                poster.style.display = 'none' if poster
                playBtn.style.display = 'none'
                video.classList.remove('hidden')
                video.play()
                container.onclick = null
                video.onclick = ->
                    if video.paused then video.play() else video.pause()

            # stop videos when they're not visible
            videoObserver = new IntersectionObserver(
                (entries) ->
                    entries.forEach (entry) ->
                        return unless entry.isIntersecting and entry.target.currentSrc?.length > 1
                        return if window.MotionPause?.paused
                        if entry.intersectionRatio >= 0.45
                            entry.target.play()
                        else
                            entry.target.pause()
                , {threshold: [0.25, 0.45]}
            )

            # section clips and the hero video have their own players (clop-demos.js, playVideo)
            document.querySelectorAll('video:not(.page-clip):not(#clop-video)').forEach (video) ->
                videoObserver.observe(video)
                rect = video.getBoundingClientRect()
                if rect? and rect.top + rect.height < 200
                    video.pause()

            # stop animations when they're not visible
            cssAnimObserver = new IntersectionObserver(
                (entries) ->
                    entries.forEach (entry) ->
                        if entry.isIntersecting
                            entry.target.style.setProperty('--animps', 'running')
                        else
                            entry.target.style.setProperty('--animps', 'paused')
                , {threshold: [0.15, 0.45]}
            )
            document
                .querySelectorAll('.dynamic-animation')
                .forEach (animation) -> cssAnimObserver.observe(animation)


        -call position="after" defs:anchors

        -stylus
            @import "stylus/base"
            @import "stylus/motion-pause"

            // a theme colour (tailwind.config.js, exposed as --color-*) at a percentage of opacity
            tok(name, pct = 100)
                if pct == 100
                    unquote('var(--color-' + name + ')')
                else
                    unquote('color-mix(in srgb, var(--color-' + name + ') ' + pct + '%, transparent)')

            blockquote
                background-color alpha(black, 0.05)
                color black
                padding 0.5rem
                border-radius 0.5rem
                margin 1rem 0
                font-size 0.85rem
                font-style italic
                font-weight 300
                line-height 1.5
                > *:first-child
                    margin-top 0
                > *:last-child
                    margin-bottom 0
                > *:only-child
                    margin 0
                em
                    color var(--color-ink-amber)


            #faq
                .anchor-headings
                    color tok('ink-mauve', 50)

                .codehilite
                    background-color tok('ink-mauve', 9)
                pre
                    color var(--color-stone-700)
                    font-size 0.9rem

                code
                    background-color tok('ink-mauve', 13)
                    color var(--color-chip-text)
                    padding 0 .5rem
                    font-weight bold

                pre code
                    background-color transparent
                    color revert
                    font-weight 500
                    padding 0
                    border-radius 0


                h2, h3, h4
                    padding 0.1rem 0.5rem
                    border-radius 0.5rem
                    color var(--color-stone-800)

                p
                    padding 0.1rem 0.5rem
                    color var(--color-stone-700)

                hr
                    border-color alpha(black, 0.1)
                    margin 2rem 0
                li
                    line-height 1.8

                img
                    max-width 700px
                    max-height 300px
                    transition: all .15s ease-out
                    border-radius 8px

                    +mobile()
                        max-height 60vh
                        max-width 80vw

                    &:hover
                        max-width 1000px
                        max-height 600px
                        transition: all .1s ease-out


            .dynamic-animation
                animation-play-state: var(--animps, paused)

            // ---- page backdrop: one page-tall blurry gradient. A faint warm drift on html, plus two
            // soft glows behind every block (--a on the demo side, --b on the copy side) in pastels
            // sampled from that block's loop and Clop's palette. The glows overrun their block so
            // neighbours melt into each other. Static gradients only: no filters, nothing animated.
            html
                background-color var(--color-orange-linen)
            body.page-glow
                background transparent
            section.feature, #hero, #video-container, #power-user, #featured, #pro, #faq-block, #traditions
                position relative
                --ax: 66%
                --bx: 30%
                --ay: 50%
                --by: 46%
                --gt: -35%
                --gb: -35%
                --a: var(--color-yellow-gold)
                --b: var(--color-orange-stone)
                &::before
                    content ''
                    position absolute
                    z-index -1
                    top var(--gt)
                    bottom var(--gb)
                    left 50%
                    width 150vw
                    margin-left -75vw
                    pointer-events none
                    background unquote('radial-gradient(ellipse 30% 44% at var(--ax) var(--ay), var(--a) 0%, color-mix(in srgb, var(--a) 78%, transparent) 28%, color-mix(in srgb, var(--a) 38%, transparent) 58%, color-mix(in srgb, var(--a) 10%, transparent) 82%, color-mix(in srgb, var(--a) 0%, transparent) 100%), radial-gradient(ellipse 30% 40% at var(--bx) var(--by), color-mix(in srgb, var(--b) 80%, transparent) 0%, color-mix(in srgb, var(--b) 55%, transparent) 30%, color-mix(in srgb, var(--b) 22%, transparent) 62%, color-mix(in srgb, var(--b) 0%, transparent) 100%)')
            section.feature:has(.flip)
                --ax: 34%
                --bx: 70%
            #hero, #video-container, #power-user, #featured, #pro, #faq-block, #traditions
                --ax: 50%
                --bx: 74%
                --by: 30%
            // phones and tablets stack copy over demo: the demo's glow sits low, the copy's high
            @media (max-width: 1023px)
                section.feature, section.feature:has(.flip)
                    --ax: 52%
                    --ay: 68%
                    --bx: 40%
                    --by: 26%
                    &::before
                        top -15%
                        bottom -15%
                        width 260vw
                        margin-left -130vw
            // glow tokens (tailwind.config.js): yellow-gold (peach), gray-white (apricot), orange-stone (cream),
            // glow-rose, glow-lavender (grayMauve), glow-sky (lightBlue), glow-mint (webp green), glow-gold
            #hero
                --a: var(--color-gray-white)
                --b: var(--color-glow-rose)
                --gt: -20%
            #video-container
                --a: var(--color-glow-rose)
                --b: var(--color-glow-lavender)
            #clipboard
                --a: var(--color-yellow-gold)
                --b: var(--color-gray-white)
            #performance
                --a: var(--color-glow-lavender)
                --b: var(--color-glow-gold)
                --ax: 50%
                --bx: 80%
            #video
                --a: var(--color-orange-stone)
                --b: var(--color-glow-lavender)
            #dropzone
                --a: var(--color-gray-white)
                --b: var(--color-glow-rose)
            #presets
                --a: var(--color-glow-rose)
                --b: var(--color-yellow-gold)
            #pipelines
                --a: var(--color-glow-lavender)
                --b: var(--color-orange-stone)
            #format-bar
                --a: var(--color-glow-sky)
                --b: var(--color-gray-white)
            #fit-under-size
                --a: var(--color-glow-rose)
                --b: var(--color-glow-gold)
            #downscale
                --a: var(--color-yellow-gold)
                --b: var(--color-glow-lavender)
            #batch-mode
                --a: var(--color-gray-white)
                --b: var(--color-glow-sky)
            #audio
                --a: var(--color-glow-rose)
                --b: var(--color-glow-lavender)
            #webp
                --a: var(--color-glow-mint)
                --b: var(--color-gray-white)
            #upload
                --a: var(--color-glow-sky)
                --b: var(--color-orange-stone)
            #integration
                --a: var(--color-glow-gold)
                --b: var(--color-glow-rose)
            #ondevice
                --a: var(--color-glow-mint)
                --b: var(--color-glow-lavender)
            #mcp-server
                --a: var(--color-yellow-gold)
                --b: var(--color-glow-sky)
            #power-user
                --a: var(--color-glow-lavender)
                --b: var(--color-glow-sky)
                --gt: -12%
                --gb: -60%
            #featured
                --a: var(--color-glow-rose)
                --b: var(--color-glow-gold)
                --gt: -90%
            #pdf-optimisation
                --a: var(--color-yellow-gold)
                --b: var(--color-glow-rose)
            #pdf-cropping
                --a: var(--color-glow-rose)
                --b: var(--color-glow-lavender)
            #pro
                --a: var(--color-orange-stone)
                --b: var(--color-glow-sky)
                --gt: -15%
                --gb: -15%
            #faq-block
                --a: var(--color-gray-white)
                --b: var(--color-glow-sky)
                --gt: -25%
                --gb: -25%
            #traditions
                --a: var(--color-glow-gold)
                --b: var(--color-glow-rose)

            // the review wall fades out at its edges whatever sits behind it
            #testimonial-wall
                -webkit-mask-image linear-gradient(to bottom, transparent, black 6rem, black calc(100% - 6rem), transparent)
                mask-image linear-gradient(to bottom, transparent, black 6rem, black calc(100% - 6rem), transparent)
            .reddit-mark
                flex none
                width 16px
                height 16px

            // ---- featured videos: side by side from 1024px, stacked below
            #featured
                display grid
                grid-template-columns minmax(0, 1fr)
                gap 3rem
                width 100%
                max-width 1200px
                justify-items center
                @media (min-width: 1024px)
                    grid-template-columns minmax(0, 1fr) minmax(0, 1fr)
            .featured-video
                width 100%
                max-width 560px
                iframe
                    display block
                    width 100%
                    height auto
                    aspect-ratio 16 / 9

            // ---- FAQ: its own paper surface, set apart from the feature flow
            #faq-block
                width 100%
                max-width 1000px
                margin-top 6rem !important
                padding 2.25rem 1.25rem 1.5rem
                border-radius 1.75rem
                background tok('stone-50', 86)
                border 1px solid tok('stone-800', 8)
                box-shadow inset 0 1px 0 alpha(white, 0.9), 0 30px 70px -36px tok('ink-mauve', 40)
                text-align left
                @media (min-width: 768px)
                    padding 3rem 3.25rem 2.25rem
                .faq-title
                    margin 0 0 0.5rem
                    padding 0 0 1.1rem 0.5rem
                    border-bottom 1px solid tok('stone-800', 10)
                    font-size 2.25rem
                    line-height 1.1
                    letter-spacing -0.01em
                    text-align left
                    color var(--color-stone-800)
                #faq
                    min-width 0
                    pre, .codehilite
                        max-width 100%
                        overflow-x auto
                    h2
                        margin-top 2.75rem
                        font-size 1.6rem
                    article > h2:first-child
                        margin-top 1.5rem

            em
                color var(--color-ink-amber)
            strong
                color var(--color-ink-rose)
            li
                margin-bottom 4px

            code
                background-color tok('ink-mauve', 13)
                color var(--color-chip-text)
                padding 0 .5rem
            .codehilite
                background-color tok('ink-mauve', 9)

            h2
                padding 0.1rem 0.5rem
                border-radius 0.5rem

            hr
                border-color tok('stone-800', 10)
            li
                line-height 1.8

            // ---- emphasis inks (ink-* in tailwind.config.js): deep tones of the glow pastels, one per
            // meaning, all AA on the backdrop. The dark panels keep their own lighter colours.
            //   ink-sky    things and places (webp, same folder, batch window), links, Free
            //   ink-mauve  pipelines and processes (pipeline, AVIF, originals are kept), keycaps
            //   ink-amber  inputs and formats (JPEG, screen recordings, AIFF), em asides
            //   ink-mint   destinations (drop zone, watched folder, screenshots, FLAC)
            //   ink-rose   warnings and Pro (PDFs, aggressive, Pro, terms), strong
            a
                color var(--color-ink-sky)
            :where(.dark-section) a
                color var(--color-blue-400)
            // keycaps and inline code are lavender chips on the light page
            code:not(.dark-section *):not(pre code)
                box-shadow inset 0 0 0 1px tok('ink-mauve', 12)
                border-radius 0.35rem
            .links
                a
                    background-color alpha(black, 0.1)
                    color black
                // footer Terms and EULA carry their own ink
                a.text-ink-rose
                    color var(--color-ink-rose)

            .dark-section
                code
                    background-color alpha(white, 0.15)
                    color var(--color-gray-100)
                em
                    color var(--color-orange-200)
                strong
                    color var(--color-orange-400)

                .codehilite
                    background-color var(--color-mauve-darkgray)
                    border 1px solid var(--color-mauve-gray)
                    code
                        color white
                        background-color transparent
                        font-weight 500
                        font-size 0.95rem

            // One content width for every row on the page: feature rows, stats and the contents of the
            // dark panels all start and end at the same x.
            section.feature
                display flex
                flex-direction column
                align-items center
                width 100%
                max-width var(--row-w)
                padding 0 0 4rem
            #traditions
                max-width var(--row-w)
            #details
                --row-w: 1200px
                --panel-pad: 1rem
                @media (min-width: 768px)
                    --panel-pad: 2rem
            // Dark panels grow past the row width by their own padding, so what sits inside them lines up
            // with the rows above and below. Edge to edge until there is room for a margin around them.
            .panel
                width calc(min(100%, var(--row-w)) + 2 * var(--panel-pad))
                max-width none
                padding-left var(--panel-pad)
                padding-right var(--panel-pad)
                border-radius 0
                > *
                    max-width 100%
                @media (min-width: 1280px)
                    border-radius 1.5rem
            .power-cols
                display grid
                grid-template-columns minmax(0, 1fr)
                gap 2rem
                width 100%
                @media (min-width: 768px)
                    grid-template-columns repeat(3, minmax(0, 1fr))
            .feature-title
                font-size 1.875rem
                line-height 1.2
                margin 0 0 1.5rem
                text-align center
                color var(--color-gray-800)
                @media (min-width: 1024px)
                    font-size 2.25rem
            .pro-pill
                display inline-block
                vertical-align middle
                margin-left 0.6rem
                margin-top -0.3rem
                padding 0.1rem 0.55rem
                border-radius 0.5rem
                font-size 0.875rem
                font-weight 700
                letter-spacing 0.02em
                color var(--color-ink-rose)
                border 1.5px solid currentColor
            // Title and copy in one column, demo in the other; .flip swaps sides from 1024px up,
            // .lean is for sections with only a title. Phones and tablets stack title, copy, demo.
            .beside
                display grid
                grid-template-columns minmax(0, 1fr)
                gap 1.5rem
                width 100%
                align-items center
                > .copy
                    display flex
                    flex-direction column
                    gap 0.6rem
                    text-align left
                    min-width 0
                    .feature-title
                        text-align left
                        margin 0 0 0.4rem
                        text-wrap balance
                > .demo
                    display flex
                    justify-content center
                    min-width 0
                // equal columns: a loop carries about the weight of its title and copy; tablets stack like phones
                @media (min-width: 1024px)
                    grid-template-columns minmax(0, 1fr) minmax(0, 1fr)
                    grid-template-areas "copy demo"
                    gap 3rem
                    > .copy
                        grid-area copy
                    > .demo
                        grid-area demo
                    &.flip
                        grid-template-areas "demo copy"
                    // title-only sections: the title column hugs its text and the pair sits centred
                    &.lean
                        grid-template-columns minmax(10rem, max-content) minmax(0, 750px)
                        justify-content center
                    &.lean.flip
                        grid-template-columns minmax(0, 750px) minmax(10rem, max-content)
            .demo img
                max-height calc(100svh - 6rem)
                object-fit contain
            // Loops fill their column (each is cropped so the subject fills the frame)
            .clip-cap
                width 100%
                margin 0 auto
            .demo-media
                width 100%
                img
                    width 100%
            .copy .codehilite, .copy pre
                max-width 100%
                overflow-x auto
            .demo-media.wide
                width 100%
            // A section with two loops: title and copy on the row's two columns, then each loop across the
            // whole row. Side by side they would be 584 px wide, which shrinks the loops' code to about 7 px;
            // at the row's full 1200 px it stays close to its recorded size.
            .lead
                display grid
                grid-template-columns minmax(0, 1fr)
                gap 0.6rem
                width 100%
                text-align left
                margin-bottom 2.5rem
                .feature-title
                    text-align left
                    margin 0 0 0.4rem
                > .copy
                    display flex
                    flex-direction column
                    gap 0.6rem
                    min-width 0
                @media (min-width: 1024px)
                    grid-template-columns minmax(0, 1fr) minmax(0, 1fr)
                    gap 3rem
                    align-items start
            .pair
                display flex
                flex-direction column
                gap 2.5rem
                width 100%
            .pair-clip
                margin 0
                min-width 0
                text-align left
            .pair-label
                margin 0 0 0.75rem
                font-size 1.125rem
                line-height 1.3
                font-weight 600
                color tok('stone-700')
                transition opacity 0.15s ease
                @media (min-width: 1024px)
                    font-size 1.375rem
            // A click or tap plays a loop and the other pauses (initClips in clop-demos.js toggles
            // .playing); the dim and play/pause button come from MotionPause.clip.
            .pair-clip
                .clip-cap
                    position relative
                &:not(.playing) .pair-label
                    opacity 0.6
            // Whole clip always visible: capped by the viewport height, never cropped, centred.
            video.page-clip
                display block
                width 100%
                height auto
                max-height calc(100svh - 6rem)
                margin 0 auto
                border-radius 1rem
                box-shadow 0 10px 30px -12px alpha(black, 0.35)
            // Every loop spans its whole column, so frames start and end at the same x in every row.
            // At most 576 px wide beside copy, which every clip covers natively (all are 1180 px or more).
            #clop-video, #video-container .video-poster
                width auto
                max-width 100%
                max-height calc(100svh - 6rem)
                margin 0 auto
            // poster and film share one frame, so the swap on play changes nothing but the picture
            .film-frame
                border-radius clamp(1.1rem, 3vw, 2rem)
                box-shadow 0 28px 60px -24px tok('stone-800', 45), 0 6px 16px -8px tok('stone-800', 25)

            // chapter thumbs under the film: generated by tools/clop-chapters.py, driven by clop-demos.js
            #chapters
                width 100%
                max-width 1000px
                margin-bottom 1.5rem
            .chapter-row
                display flex
                justify-content safe center
                gap 0.5rem
                list-style none
                margin 0
                // room above for the raised thumb and below for its title, inside the scroller's clip
                padding 0.6rem 16px 2.6rem
                overflow-x auto
                scroll-padding-inline 16px
                scrollbar-width none
                &::-webkit-scrollbar
                    display none
                li
                    position relative
                    flex 1 1 0
                    min-width 5.5rem
                    max-width 7.5rem
                // wide screens fit every section under the film without scrolling
                @media (min-width: 1024px)
                    gap 0.4rem
                    li
                        min-width 0
            .chapter
                display block
                width 100%
                padding 0
                border 0
                background transparent
                cursor pointer
                img
                    display block
                    width 100%
                    height auto
                    aspect-ratio 16 / 9
                    object-fit cover
                    border-radius 0.6rem
                    background tok('stone-800', 8)
                    box-shadow 0 2px 6px -3px tok('stone-800', 40)
                    opacity 0.8
                    transition transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.45s ease, opacity 0.3s ease, filter 0.3s ease
                &:hover img, &:focus-visible img
                    opacity 1
                    transform translateY(-2px)
                &:focus-visible
                    outline none
                    img
                        outline 2px solid tok('ink-rose', 70)
                        outline-offset 2px
            .chapter-title
                position absolute
                top calc(100% + 0.45rem)
                left 50%
                width max-content
                max-width 9rem
                transform translate(-50%, -3px)
                font-size 0.72rem
                line-height 1.2
                font-weight 600
                color var(--color-ink-mauve)
                text-align center
                opacity 0
                pointer-events none
                transition opacity 0.2s ease, transform 0.25s ease
            .chapter:hover .chapter-title, .chapter:focus-visible .chapter-title
                opacity 1
                transform translate(-50%, 0)
            // the ends keep their title inside the row instead of hanging past it
            .chapter-row li:first-child .chapter-title
                left 0
                text-align left
                transform translate(0, -3px)
            .chapter-row li:last-child .chapter-title
                left auto
                right 0
                text-align right
                transform translate(0, -3px)
            .chapter-row li:first-child .chapter:hover .chapter-title
            .chapter-row li:first-child .chapter:focus-visible .chapter-title
            .chapter-row li:last-child .chapter:hover .chapter-title
            .chapter-row li:last-child .chapter:focus-visible .chapter-title
                transform translate(0, 0)
            // once the film plays, the section on screen is lifted off the row and the rest step back
            #chapters.is-live .chapter img
                opacity 0.6
                filter saturate(0.7)
            #chapters.is-live .chapter:hover img
                opacity 0.9
                filter none
            .chapter-row li:has(.is-current)
                z-index 1
            #chapters .chapter.is-current img
                opacity 1
                filter none
                transform translateY(-6px) scale(1.1)
                box-shadow 0 14px 22px -10px tok('stone-800', 55), 0 3px 8px -4px tok('stone-800', 30)
            @media (prefers-reduced-motion: reduce)
                .chapter img, .chapter-title
                    transition opacity 0.2s ease

            // stats as plain type between two hairlines: a pastel swatch carries each stat's colour,
            // the numbers use the deeper ink of the same hue so they stay AA on the gradient
            #stats
                display grid
                grid-template-columns repeat(2, minmax(0, 1fr))
                width 100%
                border-top 1px solid tok('stone-800', 12)
                border-bottom 1px solid tok('stone-800', 12)
                @media (min-width: 1024px)
                    grid-template-columns repeat(4, minmax(0, 1fr))
                .stat
                    display flex
                    flex-direction column
                    align-items flex-start
                    gap 0.35rem
                    padding 1.4rem 1rem 1.5rem
                    text-align left
                    min-width 0
                    // inner hairlines between cells
                    &:nth-child(even)
                        border-left 1px solid tok('stone-800', 10)
                    &:nth-child(-n+2)
                        border-bottom 1px solid tok('stone-800', 10)
                    @media (min-width: 1024px)
                        padding 1.6rem 1.5rem 1.7rem
                        &:nth-child(n)
                            border-bottom none
                            border-left 1px solid tok('stone-800', 10)
                        &:first-child
                            border-left none
                .sw
                    display grid
                    place-items center
                    width 2rem
                    height 2rem
                    border-radius 50%
                .ic
                    width 1.05rem
                    height 1.05rem
                .v
                    font-size 1.6rem
                    line-height 1.15
                    font-weight 650
                    letter-spacing -0.01em
                    font-feature-settings 'tnum'
                    @media (min-width: 768px)
                        font-size 1.9rem
                    @media (min-width: 1024px) and (max-width: 1279px)
                        font-size 1.6rem
                .l
                    font-size 0.95rem
                    line-height 1.35
                    font-weight 500
                    color var(--color-stone-600)

            // FAQ screenshots sit side by side; on phones they wrap instead of running off the page
            #faq .flex-center
                flex-wrap wrap
                gap 0.5rem
                img
                    max-width 100%
                +mobile()
                    img
                        margin-left 0
