- namespace name="defs" defs.plim
---!
    import os

    # Section loops built for the page land as public/static/video/clop-page-<feature>-{h264,h265}.mp4 with a
    # poster at public/static/img/clop-page-posters/<feature>.jpg; until then the slot stays empty, or shows
    # the section's previous media where it had some.
    def has_clip(feature):
        return os.path.exists(f"public/static/video/clop-page-{feature}-h264.mp4")

    # An HEVC encode ships only where it beat H.264 on both size and SSIM; otherwise there is no -h265 file.
    def has_hevc(feature):
        return os.path.exists(f"public/static/video/clop-page-{feature}-h265.mp4")

    def clip_poster(feature):
        jpg = f"static/img/clop-page-posters/{feature}.jpg"
        return "/" + jpg if os.path.exists("public/" + jpg) else ""

    # the script's mtime as a query, so a browser never pairs a cached script with newer markup and styles
    def asset_v(path):
        return int(os.path.getmtime("public" + path))

    def has_showcase():
        return os.path.exists("public/static/video/clop-showcase-h264.mp4")

    def showcase_hevc():
        return os.path.exists("public/static/video/clop-showcase-h265.mp4")

    def showcase_poster():
        jpg = "static/img/clop-showcase-poster.jpg"
        return "/" + jpg if os.path.exists("public/" + jpg) else ""

    class CLS:
        appcontainer = "flex flex-col flex-center bg-yellow-lunar bg-opacity-30 backdrop-blur-sm px-4 py-8 rounded-2xl shadow-lg min-w-[250px] hover:shadow-2xl transition"

-def clip(feature, alt='')
    -if has_clip(feature)
        div.clip-cap
            -call video="clop-page-${feature}" cls="page-clip" poster=${clip_poster(feature)} lazy=${True} label=${alt} hevc=${has_hevc(feature)} defs:videoset

doctype html
html lang="en"
    head
        - call title="Clop - Image, video, PDF and clipboard optimiser" domain="lowtechguys.com" description="Image, video, PDF and clipboard optimiser. Copy large, paste small, send fast" favicon="/clop/favicon.ico" icon="clop-icon" icon_size="1280" screenshot="clop-screenshot" color="rgb(245, 245, 244)" canonical="/clop/" defs:head
        link href="/static/css/code.css" rel="stylesheet"
        / no defer: sets .motion-paused on <html> before first paint
        script src="/static/js/motion-pause.js?v=${asset_v('/static/js/motion-pause.js')}"
        script src="/static/js/clop-demos.js?v=${asset_v('/static/js/clop-demos.js')}" defer="true"

        -if not DEV
            script src="https://cdn.paddle.com/paddle/paddle.js" async="true" defer="true"

    body.page-glow.text-center.max-w-[100%].flex.flex-col.items-center.min-h-[100vh].justify-between.overflow-x-hidden
        header.flex.items-center.justify-between.px-4.md:px-8.max-w-[96vw].w-[96vw].h-24.text-stone-600.justify-self-end
            a.flex.flex-center.hover:transform.hover:scale-110 href="/"
                icon.w-16.h-16.md:w-20.md:h-20.filter.drop-shadow-lg.text-zinc-600 : lowtech
            .links
                a.text-sm.md:text-base.ml-4.hidden.md:inline href="/" Other apps
                a.text-sm.md:text-base.ml-4 href="/clop/privacy" Privacy
                a.text-sm.md:text-base.ml-4 href="/clop/presskit" Press Kit
                a.text-sm.md:text-base.ml-4 href="/contact?app=Clop" Contact

        section#hero.min-w-[96vw].flex-center.flex-col.relative.pb-20
            img.w-28.h-28.md:w-32.md:h-32.filter.drop-shadow-2xl src="/static/img/clop-icon.png"
            h1.mb-6.text-4xl.text-zinc-600 Clop
            h5.text-stone-600.m-0.p-0 Image, video, PDF and clipboard optimiser
            h5.text-stone-600.m-0.p-0.-mt-1 Copy large, paste small, send fast

            .flex.flex-center.mt-8.mb-2.px-2
                .flex.flex-col.justify-center.items.center
                    a.btn.text-white.bg-zinc-700.!min-h-[50px].!h-[50px].hover:text-black.hover:bg-zinc-500.!rounded-xl.!py-2.shadow-xl href="https://files.lowtechguys.com/releases/Clop.dmg"
                        .flex.flex-col.items-start
                            span.text-lg.!leading-4.mt-1 Download app
                            span.text-[0.7rem].opacity-70.font-mono.whitespace-nowrap Latest version
                    a.text-xs.mt-1.text-stone-600.decoration-dotted href="https://github.com/FuzzyIdeas/Clop/releases" Changelog
                .flex.flex-col.justify-center.items.center.ml-1.md:ml-4
                    span.relative.inline-flex
                        a#btn-paddle-hero.btn-paddle.paddle_button.h-7.!min-h-[50px].!h-[50px] href="#!" data-product="841006"
                            .flex.flex-col.items-start
                                span.text-lg.!leading-4.mt-1 Buy Clop Pro
                                span.text-[0.7rem].opacity-90.font-mono.whitespace-nowrap Lifetime license
                        span.price-badge.font-mono aria-label="€15"
                            b.now €15
                    a.text-xs.mt-1.text-stone-600.decoration-dotted href="#pro" Why Clop Pro?
            -stylus
                a#btn-paddle-hero.btn-paddle.paddle_button
                    background: var(--color-neutral-600) !important
                    box-shadow: var(--shadows-xl) !important
                // price pinned to the buy button's top-right corner, as on Cling (a discount adds s.was before .now)
                .price-badge
                    position absolute
                    top -10px
                    right -10px
                    z-index 2
                    display inline-flex
                    align-items baseline
                    gap 0.3rem
                    padding 0.15rem 0.5rem
                    border-radius 999px
                    background var(--color-neutral-800)
                    box-shadow 0 4px 10px -2px alpha(black, 0.35)
                    font-size 0.72rem
                    line-height 1.3
                    pointer-events none
                    .now
                        color var(--color-glow-gold)
                        font-weight 700

            a.btn.mt-4.text-black.bg-white.border.border-mauve-gray.hover:text-white.hover:bg-mauve-gray.flex.justify-center.items-center.!py-2.scale-90 href="https://github.com/FuzzyIdeas/Clop"
                icon.h-6.w-6.md:h-7.md:w-7.mr-2 : github
                .flex.flex-col.items-start
                    span.text-sm.md:text-base Source code
                    span.text-[0.7rem].opacity-70.font-mono.-mt-1 Licensed under `span.text-ink-rose GPLv3`

            .mt-2.font-mono.text-xs.text-zinc-900.flex.items-center.gap-1.5.select-all.opacity-70.hover:opacity-100.transition.bg-white.border.border-black/10.rounded-lg.px-3.py-1.5
                span.text-zinc-800.select-none $
                | brew install clop
            .text-ink-rose.text-xxs.mt-1.font-medium
                | compatible with macOS `b 14.0+` (Sonoma and later)

        -if has_showcase()
            div#video-container.zstack.px-4.pt-10.pb-4.w-full.max-w-[1000px].cursor-pointer onclick="playVideo(this)"
                -if showcase_poster()
                    img.video-poster.film-frame.w-full.aspect-video src=${showcase_poster()} alt="Clop optimising a screenshot as soon as it is copied"
                div#play-btn.play-btn.w-20.h-20.bg-black.bg-opacity-50.rounded-full.flex.items-center.justify-center.scale-110.hover:bg-opacity-70.transition
                    svg.w-10.h-10.text-white.ml-1 viewBox="0 0 24 24" fill="currentColor"
                        path d="M8 5v14l11-7z"
                video#clop-video.film-frame.w-full.hidden ( disablePictureInPicture muted loop playsinline preload="none" )
                    -if showcase_hevc()
                        source src="/static/video/clop-showcase-h265.mp4" type='video/mp4; codecs=hvc1'
                    source src="/static/video/clop-showcase-h264.mp4" type="video/mp4"
            / chapters:begin (generated by tools/clop-chapters.py from the film's scenes.json: edit the script, not these lines)
            nav#chapters aria-label="Chapters"
                ol.chapter-row
                    li
                        button.chapter type="button" data-start="0.000" data-end="9.767" aria-label="Optimise on copy"
                            img src="/static/img/clop-chapters/copy.webp?v=de420972" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Optimise on copy
                    li
                        button.chapter type="button" data-start="9.767" data-end="13.767" aria-label="Savings"
                            img src="/static/img/clop-chapters/savings.webp?v=40c8baa6" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Savings
                    li
                        button.chapter type="button" data-start="13.767" data-end="29.850" aria-label="Auto-optimise screen recordings"
                            img src="/static/img/clop-chapters/recording.webp?v=b426a6e8" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Auto-optimise screen recordings
                    li
                        button.chapter type="button" data-start="29.850" data-end="36.933" aria-label="Drop zone at your cursor"
                            img src="/static/img/clop-chapters/cursorzone.webp?v=28328141" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Drop zone at your cursor
                    li
                        button.chapter type="button" data-start="36.933" data-end="49.750" aria-label="Preset zones"
                            img src="/static/img/clop-chapters/presets.webp?v=a4542cc4" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Preset zones
                    li
                        button.chapter type="button" data-start="49.750" data-end="71.500" aria-label="Pipelines"
                            img src="/static/img/clop-chapters/pipelines.webp?v=f4cd7e10" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Pipelines
                    li
                        button.chapter type="button" data-start="71.500" data-end="82.833" aria-label="Batch optimisation"
                            img src="/static/img/clop-chapters/batch.webp?v=e7ce959c" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Batch optimisation
                    li
                        button.chapter type="button" data-start="82.833" data-end="90.917" aria-label="Convert in one click"
                            img src="/static/img/clop-chapters/convert.webp?v=c62333bd" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Convert in one click
                    li
                        button.chapter type="button" data-start="90.917" data-end="99.600" aria-label="Extreme compression"
                            img src="/static/img/clop-chapters/extreme.webp?v=2051109d" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Extreme compression
                    li
                        button.chapter type="button" data-start="99.600" data-end="111.183" aria-label="Fit under any size"
                            img src="/static/img/clop-chapters/fitunder.webp?v=137d9c97" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Fit under any size
                    li
                        button.chapter type="button" data-start="111.183" data-end="127.767" aria-label="Downscale and crop"
                            img src="/static/img/clop-chapters/downcrop.webp?v=05179fc8" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Downscale and crop
                    li
                        button.chapter type="button" data-start="127.767" data-end="134.933" aria-label="Optimise audio"
                            img src="/static/img/clop-chapters/audio.webp?v=926aa396" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Optimise audio
                    li
                        button.chapter type="button" data-start="134.933" data-end="150.433" aria-label="Optimise PDFs"
                            img src="/static/img/clop-chapters/pdf.webp?v=c0067fa3" alt="" width="120" height="67" loading="lazy" decoding="async"
                            span.chapter-title
                                | Optimise PDFs
            / chapters:end

        section#details.w-full.flex-center.flex-col.pb-20.space-y-16.px-4.md:px-8
            section#clipboard.feature
                .beside
                    .copy
                        h1.feature-title Optimise images as soon as you copy them
                        .text-base.lg:text-lg.text-gray-600
                            As long as the Clop app is running, every time you copy an image to your `b clipboard`, Clop will `b optimise` it to the `b smallest possible size`.
                        .text-base.lg:text-lg.text-gray-600
                            The optimised image will have minimal to zero loss in quality, and will be `b ready to paste` in any app.
                    .demo
                        .demo-media
                            -if has_clip("clipboard")
                                -call feature="clipboard" alt="A copied screenshot optimised and pasted" self:clip
                            -else
                                video.page-clip (muted loop playsinline preload="none" poster="/static/img/screenshot-clipboard.webp" src="/static/video/screenshot-copy-optimise-paste-in-email.mp4")

            section#performance.feature
                #stats
                    span.stat
                        span.sw.bg-glow-sky.text-ink-sky
                            svg.ic viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                                path d="M12 4v15M6 13l6 6 6-6"
                        span.v.text-ink-sky
                            | up to −
                            span data-count="90" 90
                            | %
                        span.l image and video size reduction
                    span.stat
                        span.sw.bg-glow-rose.text-ink-rose
                            svg.ic viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                                path d="M12 4v15M6 13l6 6 6-6"
                        span.v.text-ink-rose
                            | up to −
                            span data-count="80" 80
                            | %
                        span.l PDF size reduction
                    span.stat
                        span.sw.bg-glow-mint.text-ink-mint
                            svg.ic viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
                                rect x="6" y="6" width="12" height="12" rx="2"
                                rect x="9.5" y="9.5" width="5" height="5" rx="0.5" fill="currentColor" stroke="none"
                                path d="M9 2.5v3.5M15 2.5v3.5M9 18v3.5M15 18v3.5M2.5 9h3.5M2.5 15h3.5M18 9h3.5M18 15h3.5"
                        span.v.text-ink-mint on-device
                        span.l processing
                    span.stat
                        span.sw.bg-glow-lavender.text-ink-mauve
                            svg.ic viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                                path d="M2.5 12s3.5-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.5 6.5-9.5 6.5S2.5 12 2.5 12Z"
                                circle cx="12" cy="12" r="3"
                        span.v.text-ink-mauve visually lossless
                        span.l quality

            section#video.feature
                .beside.flip
                    .copy
                        h1.feature-title Screen recordings as small as screenshots
                        .text-base.lg:text-lg.text-gray-600
                            Sending screen recordings becomes 10x faster with Clop. The app will optimise the video as soon as you stop recording.
                        .text-sm.text-stone-600.font-medium
                            -md
                                The app also adds a number of actions you can do on a video:

                                - `crop` the video to any specific size or aspect ratio
                                - `convert` the video to `GIF`
                                - `speed up` or `slow down` the video
                                - `mute` or remove audio from the video
                                - `encode` the video to compatible formats like `mp4`
                        .text-sm.text-gray-600.mt-4.italic
                            Clop can use Apple Silicon's dedicated `b Media Engine chip` for battery-efficient video encoding without using the CPU.
                    .demo
                        .demo-media
                            -if has_clip("screen-recordings")
                                -call feature="screen-recordings" alt="A screen recording optimised as soon as it is saved" self:clip
                            -else
                                -call img="screen-recordings" factor=${0.3} mobile_factor=${0.9} pcls="block w-full" icls="rounded-2xl shadow-2xl shadow-stone-400 w-full" alt="screenshot of optimised videos as floating results in the bottom right corner of the screen" defs:image

            section#dropzone.feature
                .beside
                    .copy
                        h1.feature-title Drag and drop to optimise
                        .text-base.lg:text-lg.text-gray-600
                            Optimising files manually is as easy as dragging and dropping them on the Clop `b.text-ink-mint drop zone`.
                        .text-base.lg:text-lg.text-gray-600
                            The images and videos will be optimised in place, and URLs will be automatically downloaded before optimisation.
                        .text-base.lg:text-lg.text-gray-600
                            -md:
                                The drop zone supports a few useful keys:

                                - holding `Command` while dropping will use more **aggressive** optimisation
                                - pressing `Option` once will *show* the drop zone at the cursor
                    .demo
                        .demo-media
                            -if has_clip("drop-zone-at-cursor")
                                -call feature="drop-zone-at-cursor" alt="The drop zone appearing under the cursor mid-drag" self:clip
                            -else
                                -call video="clop-drop-zone-demo" cls="page-clip" prefix="https://files.lowtechguys.com/" poster="https://files.lowtechguys.com/clop-drop-zone-demo.webp" controls=false defs:lazyvideoset

            section#presets.feature
                .beside.flip
                    .copy
                        h1.feature-title Drop to `b Preset Zones`
                        .text-base.lg:text-lg.text-gray-600
                            The drop zone can have `b preset zones` for specific actions like `b converting to webp`, `b downscaling to 50%`, `b watermarking` and more.
                        .text-base.lg:text-lg.text-gray-600
                            The presets work by running a `b.text-ink-mauve pipeline` on the dropped file, which can be customised to include any number of actions.
                        .text-base.lg:text-lg.text-gray-600
                            -md
                                **Examples:**

                                - Downscale to 50% and convert to `webp`
                                - Upload with Dropshare and copy the URL as a markdown link
                                - Watermark with a custom logo, text or monogram
                                - Crop to 16:9 and add to last edited note
                                - *... anything you can think of really*
                    .demo
                        .demo-media
                            -if has_clip("preset-zones")
                                -call feature="preset-zones" alt="A file dropped onto a preset zone" self:clip
                            -else
                                video.page-clip (muted loop playsinline preload="none" poster="/static/img/clop-presets-poster.jpeg" src="/static/video/clop-presets.mp4")

            section#pipelines.feature
                .beside
                    .copy
                        h1.feature-title Pipelines
                        .text-base.lg:text-lg.text-gray-600
                            Pipelines run a list of actions on a file, one after the other. For example `code crop(width: 1920) -> convert(to: webp)` turns any image into a 1920px wide `b.text-ink-sky webp`.
                        .text-base.lg:text-lg.text-gray-600
                            A pipeline can be pinned to the `b.text-ink-mauve clipboard`, the `b.text-ink-amber drop zone`, a `b.text-ink-mint watched folder` or a `b.text-ink-rose preset zone`, and it will run automatically on every file that ends up there.
                        .text-sm.lg:text-base.text-stone-600
                            Clop comes with a few built-in pipelines like `code to WebP` and `code Sort screenshots`. Pipelines are free, and they can also be run from the right click menu or from the command line.
                    .demo
                        .demo-media.wide
                            -call feature="pipelines" alt="A pipeline built in Settings and pinned to the clipboard" self:clip

            section#format-bar.feature
                .beside.flip
                    .copy
                        h1.feature-title Format bar
                        .text-base.lg:text-lg.text-gray-600
                            Each floating result has a bar at the bottom with the formats the file can be converted to, like `code WEBP` and `code AVIF` for images or `code HEVC` and `code AV1` for videos.
                        .text-base.lg:text-lg.text-gray-600
                            The converted file is placed in the `b.text-ink-sky same folder` as the original. Converting again replaces the previous conversion, unless you hold `code Option` while clicking.
                        .text-sm.lg:text-base.text-stone-600
                            Some websites only accept JPEG, and a PNG photo usually gets a lot smaller as `b.text-ink-mauve AVIF` or `b.text-ink-amber JPEG`.
                    .demo
                        .demo-media
                            -if has_clip("format-bar")
                                -call feature="format-bar" alt="An image converted to AVIF from the format bar" self:clip

            section#fit-under-size.feature
                .beside
                    .copy
                        h1.feature-title Fit under size
                        .text-base.lg:text-lg.text-gray-600
                            Most chat apps and email providers have a `b.text-ink-sky file size limit`, like the 8MB limit of Discord or the 25MB limit of Gmail attachments.
                        .text-base.lg:text-lg.text-gray-600
                            Clop compresses the file harder until it fits under the chosen size, starting from the original every time. `b.text-ink-mauve Downscaling` is used only when compression is not enough.
                        .text-sm.lg:text-base.text-stone-600
                            It works for images, videos, PDFs and audio files, but it's most useful for long `b.text-ink-amber screen recordings`.
                    .demo
                        .demo-media
                            -if has_clip("fit-under-size")
                                -call feature="fit-under-size" alt="An image compressed to fit under 200KB" self:clip

            section#downscale.feature
                .beside.flip
                    .copy
                        h1.feature-title Downscale in a pinch
                        .text-base.lg:text-lg.text-gray-600
                            Get images and videos ready for sharing by scaling them down to any resolution.
                        .text-base.lg:text-lg.text-gray-600
                            Use handy hotkeys or the floating buttons to downscale the image or video and get an even smaller file size.
                        .text-base.lg:text-lg.text-gray-600
                            -md
                                * `-` downscales in steps of 25% down to half, then 10% until 10% of the original resolution
                                * `1..9` are for downscaling to specific sizes
                        .text-base.lg:text-lg.text-gray-600
                            Press the `−` button and drag to pick any size, or click the crop corner to crop the image or video to any specific size or aspect ratio.
                    .demo
                        .demo-media
                            -if has_clip("downscale")
                                -call feature="downscale" alt="A video downscaled by dragging from the − button, then a photo cropped to 1:1" self:clip
                            -else
                                video.page-clip (muted loop playsinline preload="none" poster="/static/img/downscale-images.webp" src="/static/video/screenshot-downscale-in-email.mp4")

            section#batch-mode.feature
                .beside
                    .copy
                        h1.feature-title
                            | Batch mode
                            span.pro-pill Pro
                        .text-base.lg:text-lg.text-gray-600
                            Dropping more than 30 files opens a `b.text-ink-sky batch window` instead of showing a floating result for each file. Compression, format and resolution can be set separately for images, videos, PDFs and audio.
                        .text-base.lg:text-lg.text-gray-600
                            The `b.text-ink-mauve originals are kept` until you delete the backups, so you can change the settings and run the batch again, or restore the files to how they were.
                        .text-sm.lg:text-base.text-stone-600
                            Batch mode is a `b.text-ink-amber Pro` feature. The free version can optimise up to 5 dropped files at a time.
                    .demo
                        .demo-media.wide
                            -call feature="batch-mode" alt="A large drop optimised in the batch window" self:clip

            section#audio.feature
                .beside.flip
                    .copy
                        h1.feature-title Audio optimisation
                        .text-base.lg:text-lg.text-gray-600
                            Clop can also optimise `b.text-ink-sky audio files`. By default, `b.text-ink-mauve WAV` files are converted to MP3, while `b.text-ink-amber AIFF` and `b.text-ink-mint FLAC` files are converted to AAC.
                        .text-base.lg:text-lg.text-gray-600
                            The `b.text-ink-rose cover art` is downscaled and compressed as well, and the right click menu can normalise the `b.text-ink-sky loudness` to -14 LUFS for streaming or -16 LUFS for Apple Music.
                        .text-sm.lg:text-base.text-stone-600
                            A one minute `b.text-ink-mauve WAV` recording takes about 12MB, the MP3 that Clop makes from it takes 1.2MB.
                    .demo
                        .demo-media
                            -call feature="audio-optimisation" alt="An audio file optimised with its cover art" self:clip

            section#webp.feature
                .beside
                    .copy
                        h1.feature-title Convert to `code webp` automatically
                        .text-base.lg:text-lg.text-gray-600
                            Clop's support for `b.text-ink-mauve pipelines` and `b.text-ink-amber watched folders` allows you to convert images to various formats automatically.
                        p.my-0
                            em.text-base.text-ink-rose
                                The images will be dropped in the `b same folder` as the original image by default. The image can be `b automatically renamed` with a template parameter.
                        .text-base.lg:text-lg.text-gray-600
                            The flexibility of `b.text-ink-mauve pipelines` allows you to expand the automation to include other actions like `b cropping`, `b downscaling`, `b watermarking` and even `b uploading` or `b sending` the images directly.
                    .demo
                        .demo-media
                            -if has_clip("convert-webp")
                                -call feature="convert-webp" alt="Clop's to WebP pipeline added to the Exports folder, then a photo landing there gets a WebP copy" self:clip
                            -else
                                -call img="clop-automation-webp" ext="jpeg" factor=${0.3} mobile_factor=${0.9} pcls="block w-full" icls="rounded-2xl shadow-2xl shadow-stone-400 w-full" alt="the automation tab of Clop's settings showing Convert to WEBP" defs:image

            section#upload.feature
                .beside.flip
                    .copy
                        h1.feature-title Upload with `img height="32" width="32" style="display: inline; margin-top: -4px; margin-right: -5px" src="/static/img/dropshare-icon.webp"` `a.text-dropshare.font-bold href="https://dropshare.app/" Dropshare`
                        .text-base.lg:text-lg.text-gray-600
                            Clop integrates directly with the `b Dropshare` app, to enable uploading optimised images, videos and PDFs to any of the supported services.
                        .text-base.lg:text-lg.text-gray-600
                            Uploading can be done instantly with a hotkey or from the right click menu. It's also possible to upload multiple files at once or automate the uploading based on the file location.
                    .demo
                        .demo-media
                            -if has_clip("upload-dropshare")
                                -call feature="upload-dropshare" alt="An optimised file uploaded with Dropshare" self:clip
                            -else
                                -call img="dropshare-services" factor=${0.3} mobile_factor=${0.9} pcls="block w-full" icls="rounded-2xl shadow-2xl shadow-stone-400 w-full" alt="services that the dropshare app can upload to" defs:image

            section#integration.feature
                .beside
                    .copy
                        h1.feature-title Integrate with File Shelves
                        .text-base.lg:text-lg.text-gray-600
                            Clop integrates with `b file shelf` apps like `a href="https://eternalstorms.at/yoink/mac/" Yoink`, `a href="https://hachipoo.com/dockside-app" Dockside`, `a href="https://dropoverapp.com/" Dropover` and `a href="https://github.com/Ebullioscopic/Atoll" Atoll` so you can add optimised files in their shelves for later usage.
                        .text-base.lg:text-lg.text-gray-600
                            Shelving can be done instantly with a hotkey or from the right click menu. It's also possible to shelf multiple files at once or automate the shelving with a pipeline.
                        .grid.grid-cols-2.sm:grid-cols-4.gap-x-6.gap-y-4.justify-items-center.w-max.mx-auto.mt-6
                            a.flex.flex-col.items-center.decoration-dotted href="https://eternalstorms.at/yoink/mac/"
                                img width=96 height=96 src="/static/img/yoink.png" alt="Yoink app icon"
                                b Yoink
                            a.flex.flex-col.items-center.decoration-dotted href="https://hachipoo.com/dockside-app"
                                img width=96 height=96 src="/static/img/dockside.png" alt="Dockside app icon"
                                b Dockside
                            a.flex.flex-col.items-center.decoration-dotted href="https://dropoverapp.com/"
                                img width=96 height=96 src="/static/img/dropover.png" alt="Dropover app icon"
                                b Dropover
                            a.flex.flex-col.items-center.decoration-dotted href="https://github.com/Ebullioscopic/Atoll"
                                img width=96 height=96 src="/static/img/atoll.png" alt="Atoll app icon"
                                b Atoll
                    .demo
                        .demo-media
                            -if has_clip("file-shelves")
                                -call feature="file-shelves" alt="Optimised photos added to Yoink, Dropover, Atoll and Dockside from Clop's right-click menu" self:clip
                            -else
                                -call img="clop-integrations-file-shelf" ext="jpeg" factor=${0.3} mobile_factor=${0.9} pcls="block w-full" icls="rounded-2xl shadow-2xl shadow-stone-400 w-full" alt="file shelf apps that Clop integrates with, showing Yoink and Dockside" defs:image

            section#ondevice.feature
                .beside.flip
                    .copy
                        h1.feature-title Everything happens on your device
                        .text-base.lg:text-lg.text-gray-600
                            Clop `b doesn't use any cloud services` and doesn't send any file data to the internet.
                        .text-base.lg:text-lg.text-gray-600
                            The encoders used by Clop are open-source and battle-tested over decades, so that the resulting files are fast to decode, compatible with most devices and have minimal to zero loss in quality.
                    .demo
                        .demo-media
                            -if has_clip("on-device")
                                -call feature="on-device" alt="Clop optimising files with no network use" self:clip
                            -else
                                -call img="clop-activity-monitor" factor=${0.3} mobile_factor=${0.9} pcls="block w-full" icls="rounded-2xl w-full" alt="screenshot of Activity Monitor showing Clop's zero network usage" defs:image

            section#mcp-server.feature
                .lead
                    h1.feature-title
                        | MCP server
                        span.pro-pill Pro
                    .copy
                        .text-base.lg:text-lg.text-gray-600
                            AI agents like `b.text-ink-sky Claude Code` or `b.text-ink-mauve Codex` can use Clop through its `b.text-ink-amber MCP server` to optimise, convert and crop files, write pipelines or change settings.
                        .text-base.lg:text-lg.text-gray-600
                            Coding agents can use it to optimise the `b.text-ink-mint screenshots` and `b.text-ink-rose images` they add to a project, without a separate script for each format.
                        .text-sm.lg:text-base.text-stone-600
                            The MCP server is a `b.text-ink-sky Pro` feature.
                .pair
                    figure.pair-clip
                        figcaption.pair-label Docs, demo videos and invoices
                        -call feature="mcp-server" alt="An agent setting up Clop pipelines, preset zones and settings through its MCP server" self:clip
                    figure.pair-clip
                        figcaption.pair-label Blog images, watermarks and photos
                        -call feature="mcp-server-2" alt="An agent setting up Clop pipelines on watched folders and a preset zone through its MCP server" self:clip



            / setapp-custom-banner.w-[96vw].max-w-[96vw].md:max-w-[96vw].md:w-full.lg:max-w-[1200px] iconUrl="https://store.setapp.com/app/612/9236/icon-1700588543-655cebff2c152.png" appName="Clop" appId="612" vendorId="390"
            / script type="text/javascript" src="https://developer.setapp.com/setapp-banner/index.js" async="true"

            #power-user.panel.flex.flex-col.flex-center.space-y-6.bg-stone-800.dark-section
                h1.text-3xl.text-center.lg:text-4xl.mb-1.mt-5.text-white
                    Fit for power users
                .power-cols.pb-8
                    .text-left
                        h2.text-2xl.text-left.mb-3.px-0.text-stone-200.font-medium
                            On-demand optimisation
                        .text-base.lg:text-lg.text-gray-300
                            -md
                                Press `Ctrl`-`Shift`-`C` to manually optimise the current clipboard.

                                In **Finder**, you can select images and videos and press `Ctrl`-`O` to optimise them.

                                If hotkeys are not your thing, you can also find an **Optimise with Clop** button in the Finder preview pane.
                    .text-left
                        h2.text-2xl.text-left.mb-3.px-0.text-stone-200.font-medium
                            Compatible formats
                        .text-base.lg:text-lg.text-gray-300
                            -md
                                Clop automatically **converts** less compatible formats like `HEIC`, `tiff`, `mov` to formats understood by most devices.

                                The conversion is fully configurable from the app settings.

                                Original files are kept in a backup folder which can be accessed from the app menu.
                    .text-left
                        h2.text-2xl.text-left.mb-3.px-0.text-stone-200.font-medium
                            | Pipelines
                        .text-base.lg:text-lg.text-gray-300
                            -md
                                Integrate Clop optimisation in your workflows through **pipelines**.

                                - Downscale and optimise images that you email weekly
                                - Download optimised images directly into your slideshow
                                - ..and so on
                -if has_clip("pipeline-automation")
                    .demo-media.wide.!mb-8
                        -call feature="pipeline-automation" alt="Files landing in three watched folders, each run through a Clop pipeline" self:clip

            h1#testimonials.text-3xl.text-center.lg:text-4xl.mb-8.text-black.overflow-hidden
                How people like to use Clop
            #testimonial-wall.h-[600px].overflow-hidden.relative.max-w-[100vw]
                -def card(user, link, text)
                    .flex-col.text-xs.text-left.bg-white.shadow-xl.rounded-xl.w-64.overflow-auto.h-min
                        .flex.items-center.bg-blue-100.px-3.py-2.rounded-t-xl.w-full.justify-between
                            a.text-black.font-bold href="https://old.reddit.com/r/macapps/comments/15zas8f/clop_license_giveaway_tell_me_about_your_workflow/${link}/" /u/${user}
                            svg.reddit-mark width=16 height=16 viewBox="0 0 24 24" aria-hidden="true"
                                circle cx="12" cy="12" r="11" fill="white"
                                path.fill-reddit d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"
                        .px-4.py-2.text-stone-700
                            -for paragraph in text.split('\n')
                                p ${paragraph}

                .flex.space-x-2.animate-slowscroll.dynamic-animation
                    .flex.flex-col.space-y-6.w-full.px-5
                        -call user="1Wrongdoer" link="jxgkiwg" text="Email/blog:\n\nI type tutorial guides for others and often include screenshots with arrows to make it easier for less-technical audiences to follow.\nSometimes, emails grow unwieldy in size because I tend to take screenshots that capture most of the screen and this makes it difficult to send depending on the number of images.\nI currently use Shottr to take screenshots because of the scrolling screenshot and currently, Clop monitors my folders and automatically compresses them." self:card
                        -call user="JothamLEC" link="jxh58sm" text="Team communication:\nI’m working as a marketing manager, and I frequently use Cleanshot to highlight and annotate design elements to request for adjustments via Microsoft Teams and Notion.\nThe company’s expanding rapidly, and frankly, our internet and wifi stability is struggling to keep up.\nHaving Clop helps with the upload speed." self:card
                        -call user="Qwaint" link="jxiuoy2" text="I study online, via Zoom, so my workflow is as follows:\n The Zoom presentation window on my main screen. As the lecture starts I use Shottr to set an area to capture on repeat via key bind.\n ...screenshot goes into the clipboard where Clop does its magic, allowing it a split second later to be pasted into Craft where I can take additional notes.\n Since I discovered Clop I've shrunk the size of the notes by A LOT!\n It's highly addictive to see the Clop notification with how much the size has shrunk." self:card
                        -call user="freeshare2280" link="jxkx7lc" text="I regularly need to post images on a few personal sites, and I needed to reduce the weight of the images to avoid long loading times.\n I mainly copy images for the mac-utils.com website, which lists software for Mac\n The second site I manage is for a company of archery... where I occasionally need to illustrate my articles." self:card
                        -call user="jspr_crz" link="jxi3ruc" text="With Clop, my emails with screenshots don't take up as much space, and my chat messages gets sent faster since it uploads an optimized image with smaller file size. Clop has been a staple for my work ever since I stumbled upon it.\n I work in graphic/UI/UX design and take a LOT of screenshots for client approvals daily, and with the screen that I'm using, my screenshots take up space quickly in our chat and email storage.\nWith Clop, my emails with screenshots don't take up as much space, and my chat messages gets sent faster since it uploads an optimized image with smaller file size." self:card
                        -call user="Baram31337" link="jxinga3" text="I often use screen recording and screenshots using MarginNote and Notability for YouTube lecture production.\nIt's one of my favorite apps, and when I'm making YouTube videos, Margin Notes and Notability [files] are automatically optimized when I take screen recordings and screenshots\nI'm satisfied with the good quality and reduced work." self:card
                    .flex.flex-col.space-y-6.w-full.px-5
                        -call user="PerfectFine" link="jxhlmls" text="...when I insert an inline image in mail, it takes up the entire screen and makes the email text unreadable.\n... with Clop, I just need to click - again. Clop is the most convenient app I've used for this simple task.\nI also use it for videos. Many websites have a size limit, but uploading a GIF may result in a less smooth playback.\nThe quality is still amazing, btw." self:card
                        -call user="raaamyaraaavan" link="jxhslsz" text="I write extensive technical documents with screenshots... I feel that with compressed images the documents are getting snappier.\nI also sometimes have to share the screenshots to the team ... a compressed picture helps as the recipients are not always on laptop and may have to access the media on phone.\n[Clop] is an excellent little utility which does its job without coming in the way of the work." self:card
                        -call user="LavaCreeperBOSSB" link="jxgbcsu" text="I usually use Clop to optimize screenshots I send in beeper.\nI have gigabit fiber but for some reason it always takes a while. I dont need full resolution for most things so it saves a lot of storage and time." self:card
                        -call user="JothamLEC" link="jxh58sm" text="Media manipulation:\nWorking in marketing, we frequently receive media from a boatload of different sources, namely difficult image formats like HEIC and WEBP.\nI used to right click and select convert image from the context menu — but Clop is a productivity boost." self:card
                        -call user="iamthekiller" link="jxgctiu" text="My job requires that I use Salesforce Servicecloud to respond to tickets for help.\nUnfortunately, Salesforce Servicecloud limits the inline screenshot size to a measly 1MB.\nClop allows me to speed through ticket responses, not having to worry about the size of my screenshot. It’s also right there in my clipboard, ready to paste." self:card
                        -call user="MichaelTheGeek" link="jxi80px" text="One of my blogging workflows was more complex than it needed to be. What Clop has done is remove the pain of having to use several apps to resize a photo or screenshot to post online.\nI simply take the screenshot using the built in tools or Capto, send it to the clipboard and save the resized image where I need it to be.\nClop has saved me many time consuming steps in this workflow process." self:card
                        -call user="EttVenter" link="jxj2x9g" text="I'm a photographer by profession, so I work with large quantities of images every day.\nI used to use JpegMini and ImageOptim for this stuff, and the pain in the ass it was to open one of these up, change export locations, yada yada, to get to an adjusted image.\nNow it's just a matter of export, copy, paste, and all the optimization is happening in the background before I even get to my cloud folder to paste\nAnd the added controls to keep changing the image are great too.\nClop hits the spot, dude." self:card
                    .flex.flex-col.space-y-6.w-full.px-5
                        -call user="tanerilyazov" link="jxgflhf" text="Best usecase for me is: scaling down images/GIFs of memes or screenshots to use as Slack custom emojis.\nI add a lot of screenshots to my PKM which is synced via iCloud. So going overboard can be pricy and it’s nice to have an auto resize for everything that goes in there.\nAlso sharing screencasts is a hassle due to big filesizes not being allowed through many platforms." self:card
                        -call user="areyouredditenough" link="jxgh0u3" text="I previously had a workflow where I take a screenshot for an eBay auction or social media, save it to the Desktop and then I'd open ImageOptim to compress the image and remove the EXIF data (just to be safe).\nWith GIF or screen recording it was even more cumbersome. I use Cleanshot for this, then used Handbreak to reduce the size. Oftentimes I'd have to re-encode as it was still not small enough.\nWith Clop I could skip the second step completely and just paste the image in the app. Especially with GIF & video it's a time saver." self:card
                        -call user="1Wrongdoer" link="jxgkiwg" text="Personal Knowledge Management:\n\nI like to take notes with Obsidian on things I've read and include images of flow diagrams, etc. for review down the line so I don't lose context.\nKeeping the file size small is great since I don't want my database to grow too large and slow down the program." self:card
                        -call user="snoop1823" link="jxh24yb" text="I use Clop each day dozens dozens of times.\nClop is now my must have app :)\nI discovered v1 last winter, Clop helped me a lot during of blackouts (yes I’m Ukrainian), when we had no electricity I worked a lot on my battery and overloaded cell internet connection, so each MB was a piece of gold." self:card
                        -call user="JothamLEC" link="jxh58sm" text="Company wikipage:\nThe company [I work on] sells software tools, and use Notion publishing for public documentation.\nShowing is better than telling, so we use videos, JPEGs and GIFs a lot.\nIf I'm not mistaken, Notion uploads media to AWS without compression, so Clop helps with uploading and retrieval." self:card
                        -call user="ysm" link="jxiww0s" text="A 2.7MB image is a pain to upload and to download for team members. It's nice to be able to compress them right in Clop.\nAlso, the app I use to write my reports struggles with large size photos.\nSo I always compress the images before embedding them in the document.\nI used to use the app ImageOptim to compress large photos.\n However, I don't always decide all the photos I want to include in a report at first, I tend to pick and choose as I'm writing.\nThis is where the Clop app comes in handy, as it compresses photos on demand." self:card

            #featured
                #afadingthought.featured-video
                    h3.text-stone-600.mb-0.pb-0.font-normal Featured on `a.text-stone-700 href="https://www.youtube.com/@afadingthought" "A Fading Thought"`
                    p.text-stone-600.font-normal.font-mono.text-sm.mt-0 by `em Robert J. P. Oberg`
                    iframe.shadow-xl.rounded-2xl.mt-4 width="560" height="315" loading="lazy" src="https://www.youtube-nocookie.com/embed/bKvZoED7vEo?si=QVwCVbqUS071BKRq" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen=""
                #snazzylabs.featured-video
