                        .flex.flex-col.items-start
                            span.text-lg.!leading-4.mt-1 Try for free
                            span.text-[0.7rem].text-stone-300.font-mono 14-day trial of `b.text-white Pro` features
                    p.text-xs.mt-1.text-gray-500
                        | No credit card required, keep using for free after the trial
                    p.text-xs.mt-1.text-rose-600.font-medium
                        | Refunds accepted within 14 days of purchase, no questions asked

        section#comparison.feature
            .comparison-block.text-left.prose-cling
                -md
                    ## Comparison with other apps

                    ### Spotlight, Alfred, Raycast

                    Cling is similar to these apps in that it provides instant search results, but the key differences are:

                    - **Fuzzy search**: find files with partial or misspelled queries
                    - **System files**: search system files, hidden files, dotfiles, and app data that the Spotlight index doesn't include
                    - **Extension filtering**: quickly narrow results by file type without crafting complex queries

                    ### ProFind, HoudahSpot, EasyFind, Tembo, Find Any File

                    Cling is very much not like these apps.

                    They are all file search apps that provide advanced search features, allowing you to craft complex queries using metadata and file content to dig deep into your filesystem and find as many files as possible.

                    Cling is for quickly finding one or more specific files by roughly knowing the name, and then doing something with the file immediately like:

                    - copying it for sending on chat
                    - adding to a shelf like Yoink
                    - opening it in an app like Pixelmator
                    - uploading it using Dropshare
                    - executing a script on the file

                    **Cling is not an app for finding all files that match a complex query.**

        footer.flex.items-center.justify-between.px-2.md:px-8.max-w-[100vw].w-[100vw].h-24.text-gray-500.justify-self-end.mt-auto
            - call cls="text-gray-500 hidden md:block" defs:copyright_line
            .links.w-full.md:w-auto
                - call cls="text-gray-500 justify-center md:justify-end" defs:socials
                / a.text-red-hot.ml-4 href="/contact" Contact
        -stylus
            @import "stylus/base"
            @import "stylus/motion-pause"

            // a theme colour (tailwind.config.js, exposed as --color-*) at a percentage of opacity
            tok(name, pct = 100)
                if pct == 100
                    unquote('var(--color-' + name + ')')
                else
                    unquote('color-mix(in srgb, var(--color-' + name + ') ' + pct + '%, transparent)')

            #app-icon
                filter: drop-shadow(0 0px 1px rgba(130, 50, 0, 0.4)) drop-shadow(0 9px 17px rgba(125, 65, 22, 0.4))

            blockquote
                background-color alpha(black, 0.05)
                color black
                padding 0.5rem
                border-radius 0.5rem
                margin 1rem 0
                font-size 0.85rem
                font-style italic
                font-weight 300
                line-height 1.5
                > *:first-child
                    margin-top 0
                > *:last-child
                    margin-bottom 0
                > *:only-child
                    margin 0
                em
                    color var(--color-amber-800)
            em
                color var(--color-amber-800)
            #pro em
                color var(--color-amber-300)
            #pro code, #pro .code
                color var(--color-amber-300)
                background var(--color-amber-900)
            h1, h2
                color black
            h3
                color var(--color-amber-900)
            a
                color var(--color-rose-600)
            code
                font-size smaller
            code, .code
                font-family monoSpace
                font-weight 600
                color var(--color-amber-600)
                background var(--color-amber-100)
            .codehilite
                background-color alpha(black, 0.05)
                font-size 0.8rem
            .links
                a
                    background-color alpha(black, 0.1)
                    color black

            section.feature
                display flex
                flex-direction column
                align-items center
                width 100vw
                max-width 1200px
                padding 0 1rem 6rem
            #pro .flex > .flex.flex-col
                min-width 0
            .feature-title
                font-size 1.875rem
                line-height 1.2
                margin 0 0 1.5rem
                text-align center
                color var(--color-gray-800)
                @media (min-width: 1024px)
                    font-size 2.25rem
            // Every feature row shares one width (the section's 1200px less its padding) and one grid: two equal
            // columns with the same gap, so copy and demo edges line up from section to section. A demo fills
            // its column; only a short viewport makes a clip narrower (max-height), and then it centres in it.
            .split
                display grid
                grid-template-columns minmax(0, 1fr)
                gap 1.5rem
                width 100%
                margin 0 auto
                align-items center
                > .copy
                    display flex
                    flex-direction column
                    gap 0.5rem
                    text-align left
                    min-width 0
                    .feature-title
                        text-align left
                        margin 0 0 0.5rem
                > .demo
                    display flex
                    justify-content center
                    min-width 0
                    > *
                        width 100%
                @media (min-width: 768px)
                    gap 3.5rem
                    grid-template-columns minmax(0, 1fr) minmax(0, 1fr)
                    &.flip > .copy
                        order 2
            .prose-cling
                h2
                    font-size 1.875rem
                    margin 0 0 1rem
                    text-align center
                h3
                    font-size 1.25rem
                    margin 2rem 0 0.5rem
                p, li
                    color var(--color-gray-600)
                ul
                    list-style disc
                    padding-left 1.25rem
            // ---- comparison: its own paper surface, set apart from the feature flow, on the rows' shared width
            .comparison-block
                width 100%
                padding 2.25rem 1.25rem 1.5rem
                border-radius 1.75rem
                background tok('stone-50', 86)
                border 1px solid tok('stone-800', 8)
                box-shadow inset 0 1px 0 alpha(white, 0.9), 0 30px 70px -36px tok('orange-900', 30)
                @media (min-width: 768px)
                    padding 3rem 3.25rem 2.25rem
                > *
                    max-width 760px
                h2
                    max-width none
                    margin 0 0 0.5rem
                    padding 0 0 1.1rem 0.5rem
                    border-bottom 1px solid tok('stone-800', 10)
                    font-size 2.25rem
                    line-height 1.1
                    letter-spacing -0.01em
                    text-align left
                    color var(--color-stone-800)
                h3:first-of-type
                    margin-top 1.5rem
                // the page's red-500 emphasis reads 3.6:1 on this paper; one shade deeper clears AA
                strong
                    color var(--color-red-700)
            .prompt-list
                display flex
                flex-direction column
                gap 0.3rem
                margin 0
                padding-left 1.25rem
                list-style disc
                li::marker
                    color var(--color-gray-400)
            .op-list
                display flex
                flex-direction column
                gap 0.35rem
                margin 0 0 0.25rem
                padding 0
                list-style none
            .trio .feature-title
                text-align left
                margin-bottom 0.75rem
            .trio-copy
                display flex
                flex-direction column
                gap 0.5rem
                margin-bottom 1.25rem
                text-align left
            // play/pause button and dim: MotionPause.clip
            .trio-clip
                position relative
                min-width 0
            .trio
                display grid
                grid-template-columns 1fr
                row-gap 4rem
                column-gap 2rem
                width 100%
                > .cell
                    display grid
                    grid-template-rows subgrid
                    grid-row span 3
                    min-width 0
                    row-gap 0
            .trio
                @media (min-width: 768px)
                    grid-template-columns repeat(3, minmax(0, 1fr))
            .demo-card
                width 100%
                text-align left
                background white
                border 1px solid alpha(black, 0.06)
                border-radius 1rem
                box-shadow 0 10px 30px -12px alpha(#7c2d12, 0.25), 0 2px 6px alpha(black, 0.05)
                padding 0.75rem
            .demo-media
                width 100%
            // Whole clip always visible: capped by the viewport height, never cropped, centred.
            video.page-clip
                display block
                width auto
                max-width 100%
                max-height calc(100svh - 6rem)
                margin 0 auto
                border-radius 1rem
                box-shadow 0 10px 30px -12px alpha(black, 0.35)
            .clip-empty
                width 100%
                aspect-ratio 16 / 10
                border-radius 1rem
                background alpha(#7c2d12, 0.05)
            #pro .clip-empty
                background alpha(white, 0.05)
            #cling-video, #video-container .video-poster, #raycast-video-container video, #raycast-video-container .video-poster
                width auto
                max-width 100%
                max-height calc(100svh - 6rem)
                margin 0 auto
            // poster and film share one frame, so the swap on play changes nothing but the picture
            .film-frame
                border-radius clamp(1.1rem, 3vw, 2rem)
                box-shadow 0 28px 60px -24px tok('stone-800', 45), 0 6px 16px -8px tok('stone-800', 25)

            // chapter thumbs under the film: generated by tools/cling-chapters.py, driven by cling-demos.js
            #chapters
                width 100%
                max-width 1000px
                margin-bottom 0.5rem
            .chapter-row
                display flex
                justify-content safe center
                gap 0.5rem
                list-style none
                margin 0
                // room above for the raised thumb and below for its title, inside the scroller's clip
                padding 0.6rem 16px 2.6rem
                overflow-x auto
                scroll-padding-inline 16px
                scrollbar-width none
                &::-webkit-scrollbar
                    display none
                li
                    position relative
                    flex 1 1 0
                    min-width 5.5rem
                    max-width 7.5rem
                // wide screens fit every section under the film without scrolling
                @media (min-width: 1024px)
                    gap 0.4rem
                    li
                        min-width 0
            .chapter
                display block
                width 100%
                padding 0
                border 0
                background transparent
                cursor pointer
                img
                    display block
                    width 100%
                    height auto
                    aspect-ratio 16 / 9
                    object-fit cover
                    border-radius 0.6rem
                    background tok('stone-800', 8)
                    box-shadow 0 2px 6px -3px tok('stone-800', 40)
                    opacity 0.8
                    transition transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.45s ease, opacity 0.3s ease, filter 0.3s ease
                &:hover img, &:focus-visible img
                    opacity 1
                    transform translateY(-2px)
                &:focus-visible
                    outline none
                    img
                        outline 2px solid tok('orange-500', 70)
                        outline-offset 2px
            .chapter-title
                position absolute
                top calc(100% + 0.45rem)
                left 50%
                width max-content
                max-width 9rem
                transform translate(-50%, -3px)
                font-size 0.72rem
                line-height 1.2
                font-weight 600
                color tok('stone-700')
                text-align center
                opacity 0
                pointer-events none
                transition opacity 0.2s ease, transform 0.25s ease
            .chapter:hover .chapter-title, .chapter:focus-visible .chapter-title
                opacity 1
                transform translate(-50%, 0)
            // the ends keep their title inside the row instead of hanging past it
            .chapter-row li:first-child .chapter-title
                left 0
                text-align left
                transform translate(0, -3px)
            .chapter-row li:last-child .chapter-title
                left auto
                right 0
                text-align right
                transform translate(0, -3px)
            .chapter-row li:first-child .chapter:hover .chapter-title
            .chapter-row li:first-child .chapter:focus-visible .chapter-title
            .chapter-row li:last-child .chapter:hover .chapter-title
            .chapter-row li:last-child .chapter:focus-visible .chapter-title
                transform translate(0, 0)
            // once the film plays, the section on screen is lifted off the row and the rest step back
            #chapters.is-live .chapter img
                opacity 0.6
                filter saturate(0.7)
            #chapters.is-live .chapter:hover img
                opacity 0.9
                filter none
            .chapter-row li:has(.is-current)
                z-index 1
            #chapters .chapter.is-current img
                opacity 1
                filter none
                transform translateY(-6px) scale(1.1)
                box-shadow 0 14px 22px -10px tok('stone-800', 55), 0 3px 8px -4px tok('stone-800', 30)
            @media (prefers-reduced-motion: reduce)
                .chapter img, .chapter-title
                    transition opacity 0.2s ease

            .qd-field
                min-height 2.75rem
                padding 0.55rem 0.8rem
                border-radius 0.6rem
                background var(--color-gray-100)
                border 1px solid var(--color-gray-200)
                font-family monoSpace
                font-size 15px
                line-height 1.6
                color var(--color-gray-900)
                overflow-wrap anywhere
                +mobile()
                    font-size 13px
            .qd-placeholder
                color var(--color-gray-400)
                font-family -apple-system, BlinkMacSystemFont, sans-serif
            .qd-caret
                display inline-block
                width 2px
                height 1.15em
                margin 0 -1px
                vertical-align text-bottom
                background #2f6fdb
                animation qdblink 1s steps(1) infinite
            .motion-paused .qd-caret
                animation none
            @keyframes qdblink
                50%
                    opacity 0
            .qd-sel
                background #b9d3fb
            .tk-fuzzy
                color #2f6fdb
            .tk-ext
                color var(--color-orange-600)
            .tk-not
                color var(--color-red-600)
            .tk-anchor
                color var(--color-violet-600)
            .tk-dir
                color var(--color-teal-600)
            .tk-in
                color var(--color-emerald-700)

            .qd-results
                position relative
                height 46px
                // leaving rows slide past the bottom while the list shrinks; keep them inside the card
                overflow clip
                overflow-clip-margin 6px
                // room for MAX_ROWS (6) so the card, and the page below it, never jumps while rows come and go
                min-height calc(6 * 46px)
                margin-top 0.5rem
                transition height 0.35s cubic-bezier(0.2, 0.9, 0.25, 1)
            .qrow, .exrow
                display flex
                align-items center
                gap 0.7rem
                height 46px
                padding 0 0.6rem
                border-radius 0.55rem
                img
                    flex none
                    width 28px
                    height 28px
            .qrow
                position absolute
                left 0
                right 0
                transition top 0.35s cubic-bezier(0.2, 0.9, 0.25, 1), opacity 0.3s, transform 0.3s, background 0.3s
                &.entering
                    opacity 0
                    transform translateY(-8px)
                &.leaving
                    opacity 0
                    transform translateX(14px)
            .qmain
                flex 1
                min-width 0
            .qname, .qpath
                white-space nowrap
                overflow hidden
                text-overflow ellipsis
            .qname
                font-size 14px
                font-weight 500
                color var(--color-gray-900)
            .qpath
                font-size 12px
                color var(--color-gray-500)
            .qkind
                flex none
                font-family monoSpace
                font-size 11px
                font-weight 700
                padding 0.1rem 0.45rem
                border-radius 0.35rem
                color var(--color-gray-500)
                background var(--color-gray-100)
                transition background 0.3s, color 0.3s
                &.hl-e
                    color var(--color-orange-700)
                    background var(--color-orange-100)
            .demo-card mark
                display inline-block
                padding 0
                border-radius 3px
                background transparent
                color inherit
            mark.hl-f
                color #2f6fdb
                font-weight 800
            mark.hl-a
                color var(--color-violet-700)
                background var(--color-violet-100)
                font-weight 700
            mark.hl-n
                color var(--color-red-700)
                background var(--color-red-100)
            mark.hl-d
                color var(--color-teal-800)
                background var(--color-teal-100)
                font-weight 600
            mark.hl-i
                color var(--color-emerald-800)
                background var(--color-emerald-100)
                font-weight 600
            mark.fresh, .qkind.fresh
                animation hlpop 0.55s cubic-bezier(0.3, 1.6, 0.5, 1)
            @keyframes hlpop
                0%
                    transform scale(1)
                    filter brightness(1.4)
                40%
                    transform scale(1.22)
                100%
                    transform scale(1)
            .qrow.struck, .exrow.struck
                background var(--color-red-50)
                .qname
                    text-decoration line-through 2px var(--color-red-500)

            #exclude-demo
                display grid
                gap 0.75rem
                @media (min-width: 768px)
                    grid-template-columns 1fr 300px
            .exrow
                overflow hidden
                transition height 0.35s, opacity 0.3s, background 0.3s, color 0.3s
                &.sel
                    background #2f6fdb
                    .qname
                        color white
                    .qpath
                        color alpha(white, 0.8)
                &.sel.struck
                    background var(--color-red-500)
                &.gone
                    height 0
                    opacity 0
            .ex-results
                min-height calc(6 * 46px)
            .ex-side
                display flex
                flex-direction column
                gap 0.5rem
                padding 0.5rem
                border-radius 0.75rem
                background var(--color-gray-50)
            .exopt
                display flex
                align-items center
                gap 0.55rem
                padding 0.45rem 0.55rem
                border-radius 0.45rem
                font-size 13px
                color var(--color-gray-800)
                transition background 0.25s
                .dot
                    flex none
                    width 0.85rem
                    height 0.85rem
                    border-radius 50%
                    border 1.5px solid alpha(black, 0.25)
                    transition border 0.2s
                &.on
                    background alpha(#2f6fdb, 0.1)
                    .dot
                        border 4px solid #2f6fdb
            .ex-rule
                min-height 1.6rem
                font-family monoSpace
                font-size 12px
                font-weight 600
                color var(--color-red-800)
                opacity 0
                transform scale(0.9)
                transition opacity 0.25s, transform 0.35s cubic-bezier(0.3, 1.6, 0.5, 1)
                padding 0 0.55rem
                b
                    color var(--color-red-600)
                &.on
                    opacity 1
                    transform scale(1)

            #stats
                .stat
                    display inline-flex
                    align-items baseline
                    gap 0.4rem
                    white-space nowrap
                .v
                    font-feature-settings 'tnum'
                .l
                    font-size 0.55em
                    font-weight 600
                    color var(--color-gray-500)
                .ic
                    align-self center
                    width 0.8em
                    height 0.8em
                    flex none
                .live-dot
                    align-self center
                    width 0.32em
                    height 0.32em
                    border-radius 50%
                    background var(--color-emerald-500)
                    animation livepulse 1.6s ease-out infinite
            @keyframes livepulse
                0%
                    box-shadow 0 0 0 0 alpha(#10b981, 0.6)
                100%
                    box-shadow 0 0 0 0.5em alpha(#10b981, 0)

        -coffee
            url = new URL(location)
            coupon = url.searchParams.get('coupon')

            if coupon
                document.getElementById('btn-paddle-hero')?.setAttribute('data-coupon', coupon)

            # the launch discount shows only until data-sale-until (end of 23 October, Romanian time); after that the page falls back to the full price on its own
            price = document.getElementById('cling-price')
            if price and Date.now() < Date.parse(price.dataset.saleUntil)
                price.classList.add('hidden')
                document.getElementById('cling-costs')?.classList.add('hidden')
                document.getElementById('cling-sale')?.classList.remove('hidden')

            setupPaddle = () ->
                return unless Paddle?
                clearInterval paddleObserver
                Paddle.Setup({vendor: 122873})

            paddleObserver = setInterval setupPaddle, 100

            window.playVideo = (container) ->
                container ?= document.getElementById('video-container')
                video = container.querySelector('video')
                playBtn = container.querySelector('.play-btn')
                poster = container.querySelector('picture, .video-poster')

                if video.classList.contains('hidden')
                    poster.style.display = 'none' if poster
                    playBtn.style.display = 'none'
                    video.classList.remove('hidden')
                    video.controls = false
                    video.loop = true
                    video.muted = true
                    video.playsInline = true
                    video.disablePictureInPicture = true
                    video.play()
                    container.onclick = null
                    video.onclick = ->
                        if video.paused
                            video.play()
                        else
                            video.pause()
                    return

