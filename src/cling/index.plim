- namespace name="defs" defs.plim
---!
    import os
    from utils import DEV

    # Section loops built for the page land as public/static/video/cling-page-<feature>-{h264,h265}.mp4 with a
    # poster at public/static/img/cling-page-posters/<feature>.jpg; until then the slot stays empty.
    def has_clip(feature):
        return os.path.exists(f"public/static/video/cling-page-{feature}-h264.mp4")

    # An HEVC encode ships only where it beat H.264 on both size and SSIM; otherwise there is no -h265 file.
    def has_hevc(feature):
        return os.path.exists(f"public/static/video/cling-page-{feature}-h265.mp4")

    def clip_poster(feature):
        jpg = f"static/img/cling-page-posters/{feature}.jpg"
        return "/" + jpg if os.path.exists("public/" + jpg) else ""

    class CLS:
        appcontainer = "flex flex-col flex-center bg-yellow-lunar bg-opacity-30 backdrop-blur-sm px-4 py-8 rounded-2xl shadow-lg min-w-[250px] hover:shadow-2xl transition"

-def clip(feature, alt='')
    -if has_clip(feature)
        -call video="cling-page-${feature}" cls="page-clip" poster=${clip_poster(feature)} lazy=${True} label=${alt} hevc=${has_hevc(feature)} defs:videoset
    -else
        .clip-empty

doctype html
html lang="en"
    head
        - call title="Cling - Instant fuzzy find any file, act on it in the same instant" domain="lowtechguys.com" description="Instant fuzzy find any file, act on it in the same instant" favicon="/cling/favicon.ico" icon="cling-icon" icon_size="1280" screenshot="cling-screenshot" color="rgb(255, 255, 255)" canonical="/cling/" defs:head
        link href="/static/css/code.css" rel="stylesheet"
        / no defer: sets .motion-paused on <html> before first paint
        script src="/static/js/motion-pause.js"
        script src="/static/js/cling-demos.js" defer="true"
        -if not DEV
            script src="https://cdn.paddle.com/paddle/paddle.js" async="true" defer="true"

    body.bg-orange-50.text-center.max-w-[100vw].flex.flex-col.items-center.min-h-[100vh].justify-between.overflow-x-hidden
        header.flex.items-center.justify-between.px-4.md:px-8.max-w-[100vw].w-[100vw].h-24.text-gray-500.justify-self-end
            a.flex.flex-center.hover:transform.hover:scale-110 href="/"
                icon.w-16.h-16.md:w-20.md:h-20.filter.drop-shadow-lg.text-gray-700 : lowtech
            .links
                a.text-sm.md:text-base.ml-4.hidden.md:inline href="/" Other apps
                a.text-sm.md:text-base.ml-4 href="/cling/privacy" Privacy
                a.text-sm.md:text-base.ml-4 href="/cling/presskit" Press Kit
                a.text-sm.md:text-base.ml-4 href="/contact?app=Cling" Contact

        section#hero.min-w-[100vw].flex-center.flex-col.relative.pb-2
            img#app-icon.w-28.h-28.md:w-32.md:h-32 src="/static/img/cling-icon.png"
            h1.mt-10.text-4xl.text-orange-400.mb-2.drop-shadow-xl Cling
            h5.text-gray-800 Instant fuzzy find any file
            h5.text-gray-800.m-0.p-0.-mt-1 Act on it in the same instant

            .flex.flex-center.mt-8.mb-2.px-2
                .flex.flex-col.justify-center.items.center
                    a.btn.text-white.bg-gray-700.!min-h-[50px].!h-[50px].hover:text-white.hover:bg-gray-600.!rounded-xl.!py-2.shadow-xl href="https://files.lowtechguys.com/releases/Cling.dmg"
                        .flex.flex-col.items-start
                            span.text-lg.!leading-4.mt-1 Download app
                            span.text-[0.7rem].opacity-70.font-mono.whitespace-nowrap Latest version
                    a.text-xs.mt-1.text-gray-600.decoration-dotted href="https://github.com/FuzzyIdeas/Cling/releases" Changelog
                .flex.flex-col.justify-center.items.center.ml-1.md:ml-4
                    span.relative.inline-flex
                        a#btn-paddle-hero.btn-paddle.paddle_button.h-7.!min-h-[50px].!h-[50px] href="#!" data-product="923424"
                            .flex.flex-col.items-start
                                span.text-lg.!leading-4.mt-1 Buy Cling Pro
                                span.text-[0.7rem].opacity-70.font-mono.whitespace-nowrap Lifetime license `span#cling-costs costs` `span#cling-price.text-amber-300 data-sale="€10" data-sale-until="2026-10-24T00:00:00+03:00" €15`
                        span#cling-sale.hidden.font-mono aria-label="€15, now €10"
                            s.was €15
                            b.now €10
                    a.text-xs.mt-1.text-gray-600.decoration-dotted href="#pro" Why Cling Pro?
            -stylus
                a#btn-paddle-hero.btn-paddle.paddle_button
                    background: var(--color-gray-600) !important
                    box-shadow: var(--shadows-xl) !important
                // launch discount badge pinned to the buy button's top-right corner
                #cling-sale
                    position absolute
                    top -10px
                    right -10px
                    z-index 2
                    display inline-flex
                    align-items baseline
                    gap 0.3rem
                    padding 0.15rem 0.5rem
                    border-radius 999px
                    background var(--color-gray-800)
                    box-shadow 0 4px 10px -2px alpha(black, 0.35)
                    font-size 0.72rem
                    line-height 1.3
                    pointer-events none
                    &.hidden
                        display none
                    .was
                        position relative
                        color var(--color-gray-300)
                        font-size 0.62rem
                        text-decoration none
                        &::after
                            content ''
                            position absolute
                            left -2px
                            right -2px
                            top 50%
                            border-top 1.5px solid var(--color-red-500)
                            transform rotate(-20deg)
                    .now
                        color var(--color-amber-300)
                        font-weight 700

            a.btn.mt-4.text-black.bg-white.border.border-gray-600.hover:text-white.hover:bg-gray-600.flex.justify-center.items-center.!py-2.scale-90 href="https://github.com/FuzzyIdeas/Cling"
                icon.h-6.w-6.md:h-7.md:w-7.mr-2 : github
                .flex.flex-col.items-start
                    span.text-sm.md:text-base Source code
                    span.text-[0.7rem].opacity-70.font-mono.-mt-1 Licensed under `span.text-rose-600 GPLv3`
            .mt-2.font-mono.text-xs.text-zinc-900.flex.items-center.gap-1.5.select-all.opacity-70.hover:opacity-100.transition.bg-white.border.border-black/10.rounded-lg.px-3.py-1.5
                span.text-zinc-800.select-none $
                | brew install --cask thelowtechguys-cling
            .text-orange-950.text-xxs.mt-1.font-medium.opacity-70
                | compatible with macOS `b 14.0+` (Sonoma and later)


        div#video-container.zstack.px-4.pt-10.pb-4.w-full.max-w-[1000px].cursor-pointer onclick="playVideo(this)"
            img.video-poster.film-frame.w-full.aspect-video src="/static/img/cling-showcase-poster.jpg" alt="Cling searching for an invoice by typing invsep"
            div#play-btn.play-btn.w-20.h-20.bg-black.bg-opacity-50.rounded-full.flex.items-center.justify-center.scale-110.hover:bg-opacity-70.transition
                svg.w-10.h-10.text-white.ml-1 viewBox="0 0 24 24" fill="currentColor"
                    path d="M8 5v14l11-7z"
            video#cling-video.film-frame.w-full.hidden ( disablePictureInPicture muted loop playsinline preload="none" )
                -if os.path.exists("public/static/video/cling-showcase-h265.mp4")
                    source src="/static/video/cling-showcase-h265.mp4" type='video/mp4; codecs=hvc1'
                source src="/static/video/cling-showcase-h264.mp4" type="video/mp4"
        / chapters:begin (generated by tools/cling-chapters.py from the film's scenes.json: edit the script, not these lines)
        nav#chapters aria-label="Chapters"
            ol.chapter-row
                li
                    button.chapter type="button" data-start="0.000" data-end="10.000" aria-label="Instant fuzzy search"
                        img src="/static/img/cling-chapters/fuzzy.webp?v=93d4df24" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Instant fuzzy search
                li
                    button.chapter type="button" data-start="10.000" data-end="15.667" aria-label="Speed and memory"
                        img src="/static/img/cling-chapters/speed.webp?v=0ffb224f" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Speed and memory
                li
                    button.chapter type="button" data-start="15.667" data-end="24.933" aria-label="Drop files with a hotkey"
                        img src="/static/img/cling-chapters/drop.webp?v=22d69741" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Drop files with a hotkey
                li
                    button.chapter type="button" data-start="24.933" data-end="31.767" aria-label="Index external drives"
                        img src="/static/img/cling-chapters/drives.webp?v=db9df231" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Index external drives
                li
                    button.chapter type="button" data-start="31.767" data-end="41.433" aria-label="Instant search disconnected drives"
                        img src="/static/img/cling-chapters/disconnected.webp?v=4e23f60f" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Instant search disconnected drives
                li
                    button.chapter type="button" data-start="41.433" data-end="53.100" aria-label="Find hidden files"
                        img src="/static/img/cling-chapters/hidden.webp?v=01f13d28" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Find hidden files
                li
                    button.chapter type="button" data-start="53.100" data-end="65.100" aria-label="Quick filters"
                        img src="/static/img/cling-chapters/filters.webp?v=2b06758b" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Quick filters
                li
                    button.chapter type="button" data-start="65.100" data-end="78.433" aria-label="Send large files securely"
                        img src="/static/img/cling-chapters/send.webp?v=6703c240" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Send large files securely
                li
                    button.chapter type="button" data-start="78.433" data-end="91.833" aria-label="Search your Mac from your phone"
                        img src="/static/img/cling-chapters/fileserver.webp?v=40148a21" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Search your Mac from your phone
                li
                    button.chapter type="button" data-start="91.833" data-end="103.333" aria-label="Stash files"
                        img src="/static/img/cling-chapters/stash.webp?v=7ac036aa" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Stash files
                li
                    button.chapter type="button" data-start="103.333" data-end="110.433" aria-label="Run scripts on selected files"
                        img src="/static/img/cling-chapters/scripts.webp?v=fa0e3a12" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Run scripts on selected files
                li
                    button.chapter type="button" data-start="110.433" data-end="122.767" aria-label="Exclude unwanted files"
                        img src="/static/img/cling-chapters/exclude.webp?v=01729d2e" alt="" width="120" height="67" loading="lazy" decoding="async"
                        span.chapter-title
                            | Exclude unwanted files
        / chapters:end

        h5.text-orange-600.font-bold.mb-16.motion-safe:animate-slowpulse Press `code Right Command` + `code / (slash)` to show/hide Cling

        section#details.flex-center.flex-col.pb-20.space-y-24
            .grid.grid-cols-1.md:grid-cols-2.gap-10.md:gap-14.w-screen.max-w-[1200px].px-4
                .flex.flex-col.space-y-2.text-left
                    h1.text-3xl.text-center.md:text-left.lg:text-4xl.mb-1.text-gray-800 Find any file instantly
                    .text-base.lg:text-lg.text-gray-600
                        Cling uses its own custom search engine with a binary index of your entire filesystem, providing lightning-fast fuzzy searching across millions of files in under 100ms.
                    .text-base.lg:text-lg.text-gray-600
                        Unlike Spotlight, Raycast, or Alfred, Cling can find `b.text-emerald-800 system files`, `b.text-rose-800 hidden files`, `b.text-violet-700 dotfiles`, `b.text-sky-800 app data`, and more files that the Spotlight index doesn't include.
                    h4.text-rose-600 How it works?
                    .text-sm.lg:text-base.text-gray-500
                        Cling maintains an efficient binary index of your entire disk split across separate search engines for each scope, tracking file changes live via FSEvents.
                    .text-sm.lg:text-base.text-gray-500
                        The fuzzy scoring algorithm lets you find files with just a few keystrokes, even with partial or misspelled queries. Use extension-aware queries like `code .png icon` or `code .pdf invoice` to narrow results.

                .flex.flex-col.space-y-2.text-left
                    h1.text-3xl.text-center.md:text-left.lg:text-4xl.mb-1.text-gray-800 Act on selected files
                    .text-base.lg:text-lg.text-gray-600
                        | With Cling's `b.text-emerald-800 keyboard-centric` approach, perform any action on files with quick hotkeys: `b Open with…`, copy paths, batch rename, `b QuickLook`, or drag and drop.
                    .text-base.lg:text-lg.text-gray-600
                        | `b.text-sky-800 Smart defaults` show your most recently changed files on launch, and `b.text-violet-700 search history` with arrow key navigation and tab completion makes repeated searches effortless.

        section#performance.feature
            #stats.flex.flex-wrap.items-center.justify-center.gap-x-8.md:gap-x-14.gap-y-3.px-2.text-2xl.md:text-4xl.font-bold
                span.stat
                    svg.ic.text-orange-500 viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                        path d="M13.5 2 4 13.6h6.6L9.8 22l9.7-12h-6.7z"
                    span.v.text-orange-600
                        | &lt;
                        span data-count="50" 50
                        | ms
                    span.l search
                span.stat
                    svg.ic.text-rose-500 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
                        rect x="6" y="6" width="12" height="12" rx="2"
                        rect x="9.5" y="9.5" width="5" height="5" rx="0.5" fill="currentColor" stroke="none"
                        path d="M9 2.5v3.5M15 2.5v3.5M9 18v3.5M15 18v3.5M2.5 9h3.5M2.5 15h3.5M18 9h3.5M18 15h3.5"
                    span.v.text-rose-600
                        | &lt;
                        span data-count="100" 100
                        | MB
                    span.l RAM
                span.stat
                    span.live-dot
                    span.v.text-emerald-600 live
                    span.l index

        section#operators.feature
            .split.wide
                .copy
                    h1.feature-title Search operators
                    ul.op-list
                        li.text-base.lg:text-lg.text-gray-600
                            | <code>.pdf .png</code>: several file types at once
                        li.text-base.lg:text-lg.text-gray-600
                            | <code>name/</code>: match a folder
                        li.text-base.lg:text-lg.text-gray-600
                            | <code>!word</code>: hide anything containing this
                        li.text-base.lg:text-lg.text-gray-600
                            | <code>in:~/path</code>: search only inside a folder
                        li.text-base.lg:text-lg.text-gray-600
                            | <code>'text</code>: exact text, not fuzzy
                    .text-sm.lg:text-base.text-gray-500
                        | Press `code ⌘/` in the app for the full syntax.
                .demo
                    #query-demo.demo-card
                        .qd-field
                            span.qd-text
                            span.qd-placeholder Search
                        .qd-results

        section#floating-search-bar.feature
            .split.flip
                .copy
                    h1.feature-title Floating search bar
                    .text-base.lg:text-lg.text-gray-600
                        | Cling can also show up as a `b.text-emerald-800 floating search bar` instead of the full window. The bar starts as a single search line and grows downwards as results come in.
                    .text-base.lg:text-lg.text-gray-600
                        | `code Control-Tab` switches to the results window when more space is needed.
                    .text-base.lg:text-lg.text-gray-600
                        | It can also be pinned to the desktop as a `b.text-emerald-800 small search field`, which expands into the full bar when clicked.
                .demo
                    .demo-media
                        -call feature="floating-search-bar" alt="The floating search bar" self:clip

        section#file-preview.feature
            .split
                .copy
                    h1.feature-title File preview
                    .text-base.lg:text-lg.text-gray-600
                        | Press `code ⌘⇧P` to show a `b.text-emerald-800 preview` of the selected file next to the results.
                    .text-base.lg:text-lg.text-gray-600
                        | Images and PDFs can be `b.text-emerald-800 zoomed and scrolled`, and videos play inside the preview. `b.text-rose-800 Archives` and `b.text-violet-700 disk images` show the list of files they contain.
                    .text-sm.lg:text-base.text-gray-500
                        | Code files get syntax highlighting and line numbers.
                .demo
                    .demo-media
                        -call feature="file-preview" alt="The file preview panel" self:clip

        section#act.feature
            .trio.w-full
                .cell
                    h1.feature-title.!text-2xl.lg:!text-3xl Stash
                    .trio-copy
                        .text-base.lg:text-lg.text-gray-600
                            | Press `code ⌘S` to add the selected files to the `b.text-emerald-800 stash`. It stays pinned above the results while you search for other files, and the stashed files can then be `b.text-rose-800 copied or sent` at once.
                        .text-sm.lg:text-base.text-gray-500
                            | The stash is kept between restarts.
                    .trio-clip
                        -call feature="stash" alt="Files kept in the Stash" self:clip
                .cell
                    h1.feature-title.!text-2xl.lg:!text-3xl Send securely
                    .trio-copy
                        .text-base.lg:text-lg.text-gray-600
                            | Press `code ⌘U` to get a `b.text-emerald-800 private link` for the selected files, already copied to the clipboard. Cling doesn't upload the files anywhere, they are sent `b.text-rose-800 directly from your Mac` to whoever opens the link.
                        .text-sm.lg:text-base.text-gray-500
                            | Links expire after a set time, anywhere from 1 minute to 3 days.
                    .trio-clip
                        -call feature="send-securely" alt="Sending a file over an expiring link" self:clip
                .cell
                    h1.feature-title.!text-2xl.lg:!text-3xl Drop to app
                    .trio-copy
                        .text-base.lg:text-lg.text-gray-600
                            | Press `code ⌥⏎` to drop the selected files into the `b.text-emerald-800 focused field` of the app you were using before Cling, like the upload button of a website. It works by `b.text-rose-800 simulating a drag and drop` of the files, so any app that accepts dropped files will work.
                        .text-sm.lg:text-base.text-gray-500
                            | `code ⌥⇧⏎` shows a keyboard grid for dropping the files on any spot of the screen.
                    .trio-clip
                        -call feature="drop-to-app" alt="Dropping a file into the app behind Cling" self:clip

        section#index-pruning.feature
            .split.flip
                .copy
                    h1.feature-title Index pruning
                    .text-base.lg:text-lg.text-gray-600
                        | You can also `b.text-rose-600 disable whole indexes` like System files or Library folders to speed up the search and reduce memory usage.
                .demo
                    .demo-media
                        -call feature="index-pruning" alt="Pruning heavy folders from the index" self:clip

        section#exclude-from-index.feature
            .split.wide
                .copy
                    h1.feature-title Index only what you need
                    .text-base.lg:text-lg.text-gray-600
                        | Cling allows you to `b.text-emerald-800 exclude` files from the index, so you can keep your search results clean and focused.
                    .text-base.lg:text-lg.text-gray-600
                        | The `code ~/.fsignore` file lets you specify `a href="https://git-scm.com/docs/gitignore#_pattern_format" gitignore` patterns for excluding files and folders from the index.
                .demo
                    #exclude-demo.demo-card
                        .ex-results
                        .ex-side
                            .ex-options
                            .ex-rule

        section#mcp-server.feature
            .split.flip
                .copy
                    h1.feature-title MCP server
                    .text-base.lg:text-lg.text-gray-600
                        | Cling has an `b.text-emerald-800 MCP server` so AI agents like Claude or Codex can search files and change settings in Cling.
                    .text-base.lg:text-lg.text-gray-600
                        | Agents can also find which `b.text-emerald-800 ignore rule` or `b.text-rose-800 disabled index` hides a file, and change settings for you. For example:
                    ul.prompt-list
                        li.text-base.lg:text-lg.text-gray-600
                            em &ldquo;why doesn't my ~/.ssh/config show up when I search sshcfg?&rdquo;
                        li.text-base.lg:text-lg.text-gray-600
                            em &ldquo;make a quick filter for Figma and Sketch files on Option F&rdquo;
                        li.text-base.lg:text-lg.text-gray-600
                            em &ldquo;stop indexing rust target folders but keep the binaries&rdquo;
                .demo
                    .demo-media
                        -call feature="mcp-server" alt="An agent working with Cling through MCP" self:clip

        section#raycast.flex-center.flex-col.pb-24
            .grid.grid-cols-1.md:grid-cols-2.gap-10.md:gap-14.w-screen.max-w-[1200px].px-4.items-start
                .flex.flex-col.space-y-2.text-left
                    h1.text-3xl.text-left.lg:text-4xl.mb-1.text-gray-800 Raycast extension
                    .text-base.lg:text-lg.text-gray-600
                        Search your whole filesystem with Cling's engine without leaving Raycast.
                    .text-base.lg:text-lg.text-gray-600
                        | The extension brings Cling's `b.text-orange-600 fuzzy search` and `b.text-rose-600 instant actions` straight into the Raycast command bar.
                    .!mt-8
                        a.btn.text-white.bg-[#FF6363].!min-h-[50px].!h-[50px].hover:text-white.hover:bg-[#ff4d4d].!rounded-xl.!py-2.shadow-xl.inline-flex href="https://www.raycast.com/alin/cling"
                            .flex.flex-col.items-start
                                span.text-lg.!leading-4.mt-1 Get the Raycast extension
                                span.text-[0.7rem].opacity-80.font-mono.whitespace-nowrap raycast.com/alin/cling
                div#raycast-video-container.zstack.cursor-pointer onclick="playVideo(this)"
                    img.video-poster.w-full.rounded-2xl.shadow-xl src="/static/img/cling-raycast-screencast-poster.png" alt="The Cling Raycast extension showing search results"
                    div.play-btn.w-20.h-20.bg-black.bg-opacity-50.rounded-full.flex.items-center.justify-center.scale-110.hover:bg-opacity-70.transition
                        svg.w-10.h-10.text-white.ml-1 viewBox="0 0 24 24" fill="currentColor"
                            path d="M8 5v14l11-7z"
                    video.w-full.rounded-2xl.shadow-xl.hidden ( disablePictureInPicture muted loop playsinline preload="none" )
                        source src="/static/video/cling-raycast-screencast.mp4" type="video/mp4"

        section#pro.bg-gray-800.text-white.w-full.flex-center.flex-col.py-20.space-y-16
            h2.text-3xl.lg:text-4xl.font-bold.mb-0.text-gray-100 Pro Features
            p.text-gray-400.!mt-2.px-4 Included in the 14-day free trial. After that, a license keeps them unlocked.

            .w-full.max-w-[1200px].px-4
                .split
                    .copy
                        h1.feature-title.!text-white `a.text-orange-400.font-bold href="https://www.voidtools.com/support/everything/" Everything` for Mac
                        .text-base.lg:text-lg.text-gray-300
                            Cling strives to be similar to the popular `b.text-rose-400 Everything` app from Windows, with macOS native integration and a focus on power users.
                        .text-base.lg:text-lg.text-gray-300
                            The UI is designed to be minimalistic and distraction-free, with a focus on keyboard shortcuts and fast rendering instead of pretty animations.
                    .demo
                        .demo-media
                            -call feature="everything-index" alt="Searching every file on the local disks" self:clip

            .w-full.max-w-[1200px].px-4
                .split.flip
                    .copy
                        h1.feature-title.!text-white Search external volumes
                        .text-base.lg:text-lg.text-gray-300
                            | `b USB drives`, `b external hard drives`, and `b network shares` are indexed and searchable without any latency.
                        .text-sm.lg:text-base.text-gray-400
                            | `em Persistent indexes` work even when volumes are unmounted. Reindexing happens periodically in the background.
                    .demo
                        .demo-media
                            -call feature="external-drives" alt="Searching a disconnected drive" self:clip

            .w-full.max-w-[1200px].px-4
                .split
                    .copy
                        h1.feature-title.!text-white File server
                        .text-base.lg:text-lg.text-gray-300
                            | Search this Mac and download its files from your `b phone`, a tablet or another computer, over your `b local network` or a VPN like `b Tailscale`.
                        .text-base.lg:text-lg.text-gray-300
                            | The same `b instant search` as the Cling app. `b Select` files to download them, preview images, videos, code files, PDFs. Zip them or share a `b Send Securely` link.
                        .text-sm.lg:text-base.text-gray-400
                            | `b Add it to the Home Screen` to use it like an app, with downloads kept on the phone. It only listens on private networks.
                    .demo
                        .demo-media
                            -call feature="file-server" alt="Searching a Mac and sending files from a phone" self:clip

            .grid.grid-cols-1.md:grid-cols-3.gap-12.md:gap-8.w-full.max-w-[1200px].px-4
                .flex.flex-col.space-y-2.text-left
                    h1.text-2xl.text-left.lg:text-3xl.mb-1.text-white Quick Filters
                    .text-base.text-gray-300
                        Press `code Option` + a single key to instantly narrow down results with minimal typing.
                    .text-base.text-gray-300
                        Each Quick Filter can combine `b extension matching`, `b pre-filled queries`, and `b folder restrictions` into a single hotkey.
                    .text-base.text-gray-300
                        Press `code Option` + `code Escape` to clear all filters and go back to searching everything.

                .flex.flex-col.space-y-2.text-left
                    h1.text-2xl.text-left.lg:text-3xl.mb-1.text-white Folder and Volume Filters
                    .text-base.text-gray-300
                        Save `b folder sets` and `b volume scopes` as named filters, each with its own hotkey.
                    .text-base.text-gray-300
                        Press `code Option` + a number key to jump between volumes. All filters `em stack` with your typed query.

                .flex.flex-col.space-y-2.text-left
                    h1.text-2xl.text-left.lg:text-3xl.mb-1.text-white Custom Scripts
                    .text-base.text-gray-300
                        Write scripts in `em any language`, assign a hotkey, run them on selected files.
                    .text-base.text-gray-300
                        Scripts receive `b file paths` as arguments. Build workflows like uploading, converting formats, or batch processing.

