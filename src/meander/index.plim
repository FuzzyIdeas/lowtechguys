- namespace name="defs" defs.plim

doctype html
html lang="en"
    head
        - call title="Meander - Lo-fi groove improv on the trackpad" domain="lowtechguys.com" description="MacBook trackpad as your drumpad. Tap chords, bend strings, force touch to express." favicon="/meander/favicon.ico" icon="meander-icon" icon_size="1024" screenshot="meander-screenshot" color="rgb(14, 12, 15)" canonical="/meander/" defs:head
        meta name="robots" content="noindex, nofollow"
        script src="/static/js/meander-orb.js" defer="true"

    body.text-center.max-w-[100vw].flex.flex-col.items-center.min-h-[100vh].justify-between.overflow-x-hidden style="background: #08070A"
        header.flex.items-center.justify-between.px-4.md:px-8.max-w-[100vw].w-[100vw].h-24.text-gray-500.justify-self-end
            a.flex.flex-center.hover:transform.hover:scale-110 href="/"
                icon.w-16.h-16.md:w-20.md:h-20.filter.drop-shadow-lg.text-amber-300 : lowtech
            .links
                a.text-sm.md:text-base.ml-4 href="/contact?app=Meander" Contact

        section#hero.min-w-[100vw].flex-center.flex-col.relative.pb-16.px-4
            img.w-20.h-20.md:w-28.md:h-28.filter.drop-shadow-4xl src="/static/img/meander-icon.png" alt="Meander icon"
            h1.mt-8.text-4xl.md:text-5xl.text-amber-200.monospaced Meander
            h5.text-white.mt-2 Lo-fi groove improv on the trackpad
            h5.text-white.opacity-60 MacBook trackpad as your drumpad. Tap chords, bend strings, force touch to express.

            #room.relative.mt-10.w-full.rounded-2xl.overflow-hidden.shadow-2xl.border.border-white/10
                canvas#meander-orb.absolute.inset-0.w-full.h-full
                #vignette.pointer-events-none.absolute.inset-0
                #grain.pointer-events-none.absolute.inset-0.opacity-30

            .mt-10.flex.flex-col.items-center
                a.btn.text-black.bg-amber-200.hover:bg-amber-100.!rounded-xl.!py-3.shadow-xl href="https://files.lowtechguys.com/releases/Meander-1.0.0.dmg"
                    .flex.flex-col.items-start
                        span.text-lg.!leading-5.mt-1 Download `b.opacity-50.text-sm v1.0.0`
                        span.text-[0.7rem].opacity-60.font-mono.whitespace-nowrap 166 MB `span.opacity-60 ·` every sound included
                .mt-3.font-mono.text-xs.text-gray-500 macOS 14+ `span.opacity-60 ·` Apple silicon `span.opacity-60 ·` free

        section#what.flex-center.flex-col.pb-24.px-4.max-w-[620px].text-left.space-y-4
            .text-base.text-gray-300
                Press a number and the trackpad becomes that instrument. How hard you press and how much of a fingertip lands is what the note comes out as, so a chord held flat sounds nothing like one tapped with a nail.
            .text-base.text-gray-300
                Press `b.text-amber-200 N` for a muse: a backing groove that writes itself and keeps moving through an arrangement. Play over it, loop a phrase onto `b.text-amber-200 Return`, and when something good happens press `b.text-amber-200 K`. The recording was already running, so the take arrives trimmed to the parts you played, as m4a, wav and MIDI.
            .text-base.text-gray-500.text-sm
                Nothing is fetched and nothing has to be installed first. Every sample and the encoder that renders your takes ship inside the app.

        footer.flex.items-center.justify-between.px-2.md:px-8.max-w-[100vw].w-[100vw].h-24.text-gray-500.justify-self-end
            - call cls="text-gray-100 hidden md:block" defs:copyright_line
            .links.w-full.md:w-auto
                - call defs:socials

        -stylus
            @import "stylus/base"

            #room
                width 100%
                max-width 880px
                aspect-ratio 16 / 10
                background radial-gradient(110% 90% at 50% 46%, #19151A 0%, #0E0C0F 62%, #030303 100%)

            #vignette
                background radial-gradient(105% 88% at 50% 48%, transparent 36%, rgba(2,1,3,0.5) 68%, rgba(0,0,0,0.92) 92%, #000 100%)

            #grain
                background-image url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/><feColorMatrix type='saturate' values='0'/></filter><rect width='160' height='160' filter='url(%23n)' opacity='0.32'/></svg>")
                background-repeat repeat
                mix-blend-mode overlay

            a
                color var(--color-amber-200)
            .links
                a
                    background-color alpha(white, 0.1)
                    color warmWhite
