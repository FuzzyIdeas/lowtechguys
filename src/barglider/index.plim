- namespace name="defs" defs.plim

doctype html
html lang="en"
    head
        - call title="Barglider - Menubar navigation from the trackpad" domain="lowtechguys.com" description="Drum three fingers to pick an icon in the menubar, glide with two fingers to walk to any icon, swipe down to open menus." favicon="/static/img/barglider-icon.png" icon="barglider-icon" icon_size="1024" screenshot="barglider-icon" color="rgb(12, 8, 6)" canonical="/barglider/" defs:head

    body.text-center.max-w-[100vw].flex.flex-col.items-center.min-h-[100vh].overflow-x-hidden style="background: #0C0806"
        header.flex.items-center.justify-between.px-4.md:px-8.max-w-[100vw].w-[100vw].h-24.text-gray-500.justify-self-end
            a.flex.flex-center.hover:transform.hover:scale-110 href="/"
                icon#logo.w-16.h-16.md:w-20.md:h-20.filter.drop-shadow-lg : lowtech
            .links
                a.text-sm.md:text-base.ml-4 href="/contact?app=Barglider" Contact

        section#hero.min-w-[100vw].flex-1.flex-center.flex-col.relative.pb-16.px-4
            img.w-20.h-20.md:w-28.md:h-28.filter.drop-shadow-4xl src="/static/img/barglider-icon.png" alt="Barglider icon"
            h1#title.mt-8.text-4xl.md:text-5xl.monospaced Barglider
            h5#tagline.mt-2 Menubar navigation from the trackpad
            h5#subtagline.opacity-60 Glide, pick, and click icons with gestures

            #stage.mt-10.w-full
                video#demo.w-full.block (autoplay muted loop disablePictureInPicture playsinline)
                    source src="/static/video/barglider-demo-full.mp4" type="video/mp4"

            .mt-10.flex.flex-col.items-center
                a#download.btn.!rounded-xl.!py-3.shadow-xl href="https://files.lowtechguys.com/releases/Barglider-1.0.0.dmg"
                    .flex.flex-col.items-start
                        span.text-lg.!leading-5.mt-1 Download `b.opacity-50.text-sm v1.0.0`
                        span.text-[0.7rem].opacity-60.font-mono.whitespace-nowrap 4.4 MB `span.opacity-60 ·` macOS 26+ `span.opacity-60 ·` Universal

        #grain.pointer-events-none

        footer.flex.items-center.justify-between.px-2.md:px-8.max-w-[100vw].w-[100vw].h-24.text-gray-500.mt-auto.shrink-0
            - call cls="text-gray-100 hidden md:block" defs:copyright_line
            // The copyright hides on mobile, so the socials are alone down
            // there: centre them rather than leaving them hanging on the left.
            .links.w-full.md:w-auto
                - call cls="text-gray-500 justify-center md:justify-end" defs:socials

        -stylus
            @import "stylus/base"

            // Same palette as the app's onboarding: a near-black mauve room,
            // cream for text, amber for anything lit.
            ink = #1B1219
            inkDeep = #0C0806
            cream = #EFE1D0
            amber = #F68004

            #logo, #title
                color amber
            #tagline, #subtagline
                color cream

            // The clip is recorded on a canvas far wider than its content, so
            // the outer fifth of every side is flat background. Browsers decode
            // the same h264 to slightly different near-blacks, so the clip's
            // background can never be trusted to equal the page's. The vignette
            // spends that empty margin fading the video out entirely: what
            // touches the page is the page.
            #stage
                width 100%
                max-width 1000px

            // The fade has to reach zero exactly at each edge, which a radial
            // cannot do: its radii are measured against the box, so anything
            // over 50% leaves the sides still half-painted, which is the edge
            // Firefox was drawing. Two linear fades intersected hit zero on all
            // four sides. The stops clear the content: the widest prop spans
            // 19%-81% across and 14%-86% down.
            #demo
                aspect-ratio 1120 / 760
                margin 0
                border-radius 0
                box-shadow none
                -webkit-mask-image linear-gradient(to right, transparent 0%, #000 20%, #000 80%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 15%, #000 85%, transparent 100%)
                -webkit-mask-composite source-in
                -webkit-mask-repeat no-repeat
                mask-image linear-gradient(to right, transparent 0%, #000 20%, #000 80%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 15%, #000 85%, transparent 100%)
                mask-composite intersect
                mask-repeat no-repeat

            // Near-black gradients band badly in 8 bits, and the vignette on
            // the clip is one long ramp through exactly that range. A film of
            // monochrome noise over the whole page dithers the steps away, and
            // it lands on the video too, which hides its own banding.
            #grain
                position fixed
                top 0
                left 0
                width 100%
                height 100%
                z-index 50
                background-image url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/><feColorMatrix type='saturate' values='0'/></filter><rect width='160' height='160' filter='url(%23n)' opacity='0.34'/></svg>")
                background-repeat repeat
                mix-blend-mode overlay
                opacity 0.5

            #download
                background-color amber
                color inkDeep
                &:hover
                    background-color lighten(amber, 12%)

            a
                color amber
            .links
                a
                    background-color alpha(cream, 0.08)
                    color cream
